# flash-next-swarm-quad3090 v1.0: server settings, as the reference host runs them (paths are generic; HOST defaults to
# 127.0.0.1 here, the reference host serves its LAN).
# scripts/run-swarm.sh and systemd/flash-next-swarm.service load this file, then config/local.env (machine-specific:
# paths, the RAM tier, host, port and API key, written by setup.sh), then start scripts/serve-swarm.sh.
# Shell syntax; values with JSON stay single-quoted.

# --- paths (override in config/local.env) ---
TREE=./vllm-swarm                    # scripts/build-swarm.sh SRC_DIR
VENV=./venv-swarm                    # scripts/build-swarm.sh VENV_DIR
CKPT=./models/Swift1.5-Merlin        # halt95/Swift1.5-Qwen3.8-Flash-Next-W4A16-Merlin
DRAFTER=./models/DFlash2-swiftembed  # scripts/graft-drafter-embed.py output
CACHE_ROOT=./cache                   # torch.compile / cudagraph cache; the first boot compiles (about 10 min)
HOST=127.0.0.1                       # 0.0.0.0 for the LAN, with API_KEY set (setup.sh --host 0.0.0.0 does both)
PORT=8000

# --- RAM KV tier: agent conversations cached in system RAM (config/local.env sets RAM_TIER_GIB; docs/swarm/ram-sizing.md) ---
RAM_TIER_GIB=130
# Offload row stride: every worker and the scheduler must use the same bytes per block (PP ranks derive different
# values). 10485760 matches this configuration (FP4 attention KV, side-cache layout); the boot log prints the derived
# value as "offload-stride:". Change it only together with the KV settings.
VLLM_OFFLOAD_WORKER_KV_BYTES_PER_BLOCK=10485760
VLLM_OFFLOAD_EAGLE_DROP=0
VLLM_E2_SIDE_CACHE_OFFLOAD=1         # store the small per-layer caches beside the KV rows once, not twice
REPLAYSSM=1                          # RecoverSSM (exact DeltaNet state after speculative decoding) with the RAM tier

# --- KV pool ---
KV_CACHE_MEMORY=3900000000           # bytes per GPU: 1,212,416 tokens; 3.95e9 had OOM retries under stress
VLLM_EXP_QSA_KV_FP4=1                # FP4 attention KV (per-16 FP8 scales)
VLLM_EXP_QSA_FP4_WARPS=4
MAX_NUM_SEQS=16

# --- speculative decoding: DFlash 2, 7 drafts for 1 request, 3 for 2-8, 2 for 9-16 ---
SPEC_DRAFTS='[[1,1,7],[2,8,3],[9,16,2]]'
VLLM_EXP_SW_BLOCK_SIZE=1024          # drafter window cache page; NEVER without VLLM_EXP_SW_SCRATCH=1 (long prompts stall)
VLLM_EXP_SW_SCRATCH=1
VLLM_EXP_DRAFT_EMBED_HOST=1          # drafter input embedding in pinned host memory (~636 MB/GPU freed on PP1)
VLLM_EXP_DRAFT_HEAD_INT8=1
VLLM_EXP_EAGER_EMBED_MASK=1          # avoids a torch.compile recompile deadlock with 7 drafts + the RAM tier
CG_SIZES=1,2,3,4,6,8,12,16,24,32,40,48,56,64
V2_RUNNER=1

# --- kernels (sm_86) ---
VLLM_MARLIN_INPUT_DTYPE=int8         # INT8 MoE activations; empty = BF16 (INT8 costs +0.9-1.5% perplexity on code)
VLLM_EXP_SKINNY_SM86=1
VLLM_EXP_SKINNY_SM86_HC=1
VLLM_EXP_SKINNY_SM86_PLANS=./config/skinny-plans-sm86.json
VLLM_EXP_MOE_SMALL=1
VLLM_EXP_SPARSE_LOGITS=1
VLLM_EXP_TOPK_FIRST=1
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=32

# --- communication ---
NCCL_PROTO_OVERRIDE=LL,Simple
VLLM_E2_CUSTOM_AR_SAME_ROOT=1        # custom all-reduce only within one PCIe root complex
VLLM_E2_CUSTOM_AR_MAX_BYTES=131072
VLLM_ALLREDUCE_USE_FLASHINFER_PCIE_IPC=1

# --- scheduling ---
VLLM_E2_PP_DECODE_BALANCE=1          # split decode batches evenly across the two pipeline stages
VLLM_E2_MAMBA_RETAIN_ADAPTIVE_S=45   # keep DeltaNet (GDN) state checkpoints while requests queue; drop them 45 s after it empties

# --- API ---
# Server default when a request does not say: empty = the engine's default (thinking on, reasoning_effort "low"), as the
# reference host runs. halt95's Swift recipe and Merlin 3.0.0 default to "xhigh". Requests override it per call.
REASONING_EFFORT=
VLLM_EXP_SEG_TOKENIZE=1              # segmented prompt tokenization (exact; faster on 100K prompts)
VLLM_EXP_REJECT_PROMPT_LOGPROBS=1    # prompt logprobs are refused with a 400 (a 1024-token chunk of them OOMs PP1)
