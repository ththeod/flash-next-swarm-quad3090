+    def get_sparse_logits(
+        self,
+        lm_head: VocabParallelEmbedding,
+        hidden_states: torch.Tensor,
+        k: int,
+        embedding_bias: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        """Full-vocab logits that keep only each TP shard's top-k entries and
+        are -inf elsewhere (VLLM_EXP_SPARSE_LOGITS). After any top-k <= k
+        sampling filter they equal the all-gathered logits (the global top-k
+        is inside the union of the shards' top-k), at O(batch * k * tp)
+        communication instead of O(batch * vocab). Soft cap and scale as in
+        forward(); the caller guarantees no logits processing that could lift
+        a token from outside the shards' top-k (penalties, bias, bad words,
+        logprobs, grammar)."""
+        if self.scale <= 0.0:
+            raise ValueError("sparse logits need a positive logit scale")
+        logits = self._apply_head(lm_head, hidden_states, embedding_bias)
+        num_pad = lm_head.shard_indices.num_org_vocab_padding
+        if num_pad > 0:
+            logits[..., -num_pad:] = -float("inf")
+        values, ids = _topk(logits, k)
+        ids = ids.to(torch.int64) + lm_head.shard_indices.org_vocab_start_index
+        if lm_head.tp_size > 1:
+            values = tensor_model_parallel_all_gather(values, dim=-1)
+            ids = tensor_model_parallel_all_gather(ids, dim=-1)
+        if self.soft_cap is not None:
+            values = torch.tanh(values / self.soft_cap) * self.soft_cap
+        if self.scale != 1.0:
+            values = values * self.scale
+        out = values.new_full((values.shape[0], self.org_vocab_size), float("-inf"))
+        return out.scatter_(1, ids, values)
+
     def extra_repr(self) -> str:
         s = f"vocab_size={self.vocab_size}"
         s += f", org_vocab_size={self.org_vocab_size}"
