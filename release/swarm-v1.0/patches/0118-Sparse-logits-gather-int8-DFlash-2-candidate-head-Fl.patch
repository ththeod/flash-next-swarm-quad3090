+    def sparse_logits_ok(self, idx_mapping_np: np.ndarray) -> bool:
+        """VLLM_EXP_SPARSE_LOGITS: True when every scheduled request samples
+        from a top-k <= SPARSE_LOGITS_K, wants no logprobs, and has no logits
+        processing that could lift a token from outside the TP shards' top-k
+        (logit bias / allowed tokens / min_tokens, penalties, bad words,
+        thinking budget). Host-side state only, identical on every TP rank."""
+        if not SPARSE_LOGITS or len(idx_mapping_np) == 0:
+            return False
+        if self.trace_replay_state is not None:
+            return False
+        st = self.sampling_states
+        idx = idx_mapping_np
+        if np.any(st.top_k.np[idx] > SPARSE_LOGITS_K):
+            return False
+        if np.any(st.num_logprobs[idx] != NO_LOGPROBS):
+            return False
+        if (
+            np.any(self.logit_bias_state.use_logit_bias[idx])
+            or np.any(self.penalties_state.use_penalty[idx])
+            or np.any(self.bad_words_state.num_bad_words.np[idx] > 0)
+        ):
+            return False
+        if self.thinking_budget_state.enabled and np.any(
+            self.thinking_budget_state.use_thinking_budget[idx]
+        ):
+            return False
+        return True
