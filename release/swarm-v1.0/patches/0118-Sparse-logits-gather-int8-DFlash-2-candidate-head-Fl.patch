+def launch_w8(
+    x: torch.Tensor,
+    q: torch.Tensor,
+    scale: torch.Tensor,
+    cfg: Config,
+    out: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Y = X @ (Q * scale[:, None])^T, Q int8 [N, K], scale fp32 [N]."""
+    bm, bn, bk, _, warps, stages = cfg
+    m, k = x.shape
+    n = q.shape[0]
+    y = out if out is not None else x.new_empty((m, n))
+    _skinny_gemm_w8_kernel[(triton.cdiv(m, bm), triton.cdiv(n, bn))](
+        x,
+        q,
+        scale,
+        y,
+        m,
+        n,
+        k,
+        x.stride(0),
+        q.stride(0),
+        y.stride(0),
+        BLOCK_M=bm,
+        BLOCK_N=bn,
+        BLOCK_K=bk,
+        num_warps=warps,
+        num_stages=stages,
+    )
+    return y
+
+
+def quantize_rows_int8(
+    w: torch.Tensor, chunk: int = 8192
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Symmetric per-row int8 (absmax / 127), in row chunks so the fp32
+    temporaries stay small (the 124K-row LM head shard is 636 MB in bf16)."""
+    q = torch.empty(w.shape, dtype=torch.int8, device=w.device)
+    s = torch.empty(w.shape[0], dtype=torch.float32, device=w.device)
+    for r in range(0, w.shape[0], chunk):
+        blk = w[r : r + chunk].float()
+        sc = blk.abs().amax(dim=1).clamp_min(1e-12) / 127.0
+        q[r : r + chunk] = torch.round(blk / sc[:, None]).clamp_(-127, 127).to(torch.int8)
+        s[r : r + chunk] = sc
+    return q, s
+
+
+def w8_plan(shape: tuple[int, int], m: int) -> Config | None:
+    load_plans()
+    return _w8_plans.get(shape, {}).get(m_bucket(m) or 0)
+
+
+def attach_int8_draft_head(model: nn.Module) -> None:
+    """VLLM_EXP_DRAFT_HEAD_INT8=1: give the DFlash 2 drafter an int8 copy of its
+    (shared, bf16) LM head shard for candidate selection only. The drafter's
+    candidates and scores come from it; verification still uses the target's
+    bf16 logits, so outputs are unchanged (drafts may differ slightly)."""
+    if not (DRAFT_HEAD_INT8 and is_supported()):
+        return
+    head = getattr(model, "lm_head", None)
+    weight = getattr(head, "weight", None)
+    if weight is None or weight.dim() != 2 or weight.device.type != "cuda":
+        return
+    q, s = quantize_rows_int8(weight.data)
+    model._draft_head_q = q
+    model._draft_head_s = s
+    logger.info(
+        "DFlash 2 drafter: int8 candidate head %s (%.0f MiB; w8 plans for M buckets %s)",
+        tuple(q.shape),
+        q.numel() / 2**20,
+        sorted(_w8_plans.get(tuple(q.shape), {})) or "none",
+    )
+
+
+def draft_head_override(model: nn.Module, hidden_states: torch.Tensor):
+    """Head projection for get_top_k_tokens(head_override=...), or None."""
+    q = getattr(model, "_draft_head_q", None)
+    if q is None or hidden_states.dim() != 2 or hidden_states.stride(1) != 1:
+        return None
+    cfg = w8_plan((int(q.shape[0]), int(q.shape[1])), hidden_states.shape[0])
+    if cfg is None or hidden_states.dtype != torch.bfloat16:
+        return None
+    s = model._draft_head_s
+    return lambda h: launch_w8(h, q, s, cfg)
+
+
 def scratch_size(cfg: Config, n: int, m: int = M_MAX) -> tuple[int, int]:
     """fp32 partial elements and counters a config needs for up to m x n."""
     bm, bn, _, sk, _, _ = cfg
