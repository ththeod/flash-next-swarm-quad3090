     hidden_states: torch.Tensor,
     w1: torch.Tensor,
@@ -714,6 +723,21 @@ class MarlinExperts(LoRAExpertsMixin, MarlinExpertsBase):
         assert self.w2_scale is not None
 
         ctx = self._lora_context
+        _dbg = (_E2_INT8_DBG[0] > 0 and hidden_states.size(0) >= 16
+                and bool(hidden_states.abs().amax() > 0))  # skip warm-up / profiling passes (all-zero input)
+        if _dbg:
+            _E2_INT8_DBG[0] -= 1
+            _s1 = self.w1_scale
+            _e2_logger.warning(
+                "E2-INT8-DBG in: x %s %s absmax %.4g | input_dtype %s | a1_gscale %s a2_gscale %s | "
+                "w1 %s %s w2 %s | w1_scale %s %s first int16 %s | quant_type %s | expert_map %s | act %s",
+                hidden_states.dtype, tuple(hidden_states.shape), hidden_states.float().abs().max().item(),
+                self.input_dtype,
+                None if self.a1_gscale is None else self.a1_gscale.float().flatten()[:2].tolist(),
+                None if self.a2_gscale is None else self.a2_gscale.float().flatten()[:2].tolist(),
+                w1.dtype, tuple(w1.shape), tuple(w2.shape), _s1.dtype, tuple(_s1.shape),
+                _s1.view(torch.int16).flatten()[:6].tolist() if _s1.element_size() == 2 else None,
+                self.quant_type_id, None if expert_map is None else int((expert_map >= 0).sum()), activation)
         if ctx is None:
             fused_marlin_moe(
                 hidden_states=hidden_states,
@@ -746,6 +770,10 @@ class MarlinExperts(LoRAExpertsMixin, MarlinExpertsBase):
                 intermediate_cache2=workspace13,
                 input_dtype=self.input_dtype,
             )
+            if _dbg:
+                _e2_logger.warning("E2-INT8-DBG out: absmax %.4g mean|.| %.4g nan %d",
+                                   output.float().abs().max().item(), output.float().abs().mean().item(),
+                                   int(torch.isnan(output).sum()))
             return
 
         # LoRA path: wrap activation_func and moe_sum to inject LoRA at the
diff --git a/vllm/model_executor/layers/quantization/utils/marlin_utils.py b/vllm/model_executor/layers/quantization/utils/marlin_utils.py
index 22cf18f..9deb452 100644
--- a/vllm/model_executor/layers/quantization/utils/marlin_utils.py
+++ b/vllm/model_executor/layers/quantization/utils/marlin_utils.py
@@ -475,8 +475,12 @@ def marlin_permute_bias(s: torch.Tensor) -> torch.Tensor:
 
 
 def marlin_act_int8_process_scales(s: torch.Tensor):
-    a_scales_scale_factor = 1 / 4096 * s.max().float()
-    s = s / s.max() * 4096
+    # Normalize by the absolute maximum: some checkpoints (e.g. Merlin-quantized
+    # Swift/Qwen3.8 experts) fold a sign into ~half of the group scales, and the
+    # INT8 kernel now reads these int16 scales as signed (local fix, W47).
+    s_absmax = s.abs().max()
+    a_scales_scale_factor = 1 / 4096 * s_absmax.float()
+    s = s / s_absmax * 4096
     s = s.round().to(torch.int16).view(s.dtype)
     return s, a_scales_scale_factor
 
