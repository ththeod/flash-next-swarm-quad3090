+# SPDX-License-Identifier: Apache-2.0
+"""W4A8-INT8 Marlin MoE with SIGNED group scales (local 2026-10-23, W47).
+
+Merlin-quantized checkpoints fold a sign into ~half of the group scales. The INT8 kernel used to read the
+int16-normalized scales as uint16, which turned every negative scale into ~65K (~20,000x error, garbage output).
+Exercises the load-time path: GPTQ-packed weights -> oracle _process_weights_marlin(int8) -> fused_marlin_moe with the
+INT8 global activation scales, against a torch reference on the dequantized weights.
+"""
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from tests.kernels.utils import torch_experts
+from vllm.config import VllmConfig, set_current_vllm_config
+from vllm.model_executor.layers.fused_moe import fused_topk
+from vllm.model_executor.layers.fused_moe.experts.marlin_moe import fused_marlin_moe
+from vllm.model_executor.layers.fused_moe.oracle.int_wna16 import _process_weights_marlin
+from vllm.model_executor.layers.quantization.utils.quant_utils import gptq_pack, quantize_weights
+from vllm.scalar_type import scalar_types
+
+G = 128
+QT = scalar_types.uint4b8
+
+
+def _ct_pack(w, signed):
+    refs, qs, ss = [], [], []
+    for i in range(w.shape[0]):
+        w_ref, q_w, s = quantize_weights(w[i].T.contiguous(), QT, G)[:3]
+        if signed:
+            m = torch.where(torch.rand_like(s.float()) < 0.5, -1.0, 1.0).to(s.dtype)
+            s = s * m
+            w_ref = w_ref * m.repeat_interleave(G, dim=0)
+        qs.append(gptq_pack(q_w, 4, q_w.shape[0], q_w.shape[1]))
+        ss.append(s)
+        refs.append(w_ref.T)
+    return torch.stack(refs), torch.stack(qs), torch.stack(ss)
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="needs a GPU")
+@pytest.mark.parametrize("signed", [False, True])
+@pytest.mark.parametrize("int8", [False, True])
+@pytest.mark.parametrize("m,ep", [(256, 1), (256, 2), (8, 2)])
+def test_marlin_moe_signed_scales(signed, int8, m, ep):
+    torch.manual_seed(2)
+    n, k, e, topk, dtype = 640, 2560, 16, 4, torch.bfloat16
+    a = torch.randn((m, k), device="cuda", dtype=dtype) / 10
+    w1 = torch.randn((e, 2 * n, k), device="cuda", dtype=dtype) / 10
+    w2 = torch.randn((e, k, n), device="cuda", dtype=dtype) / 10
+    e_map = None
+    if ep > 1:
+        le = e // ep
+        ids = torch.randperm(e, device="cuda", dtype=torch.int32)[:le]
+        e_map = torch.full((e,), -1, device="cuda", dtype=torch.int32)
+        e_map[ids] = torch.arange(le, device="cuda", dtype=torch.int32)
+        w1, w2 = w1[ids], w2[ids]
+    r1, p1, s1 = _ct_pack(w1, signed)
+    r2, p2, s2 = _ct_pack(w2, signed)
+    layer = SimpleNamespace(intermediate_size_per_partition=n, num_groups_w13=k // G, num_groups_w2=n // G)
+    in_dt = torch.int8 if int8 else None
+    q1, q2, ms1, ms2, _, _, g1, g2, _, _ = _process_weights_marlin(layer, in_dt, 4, 8, G, p1, p2, s1, s2)
+    score = torch.randn((m, e), device="cuda", dtype=dtype)
+    tw, tid, _ = fused_topk(a, score, topk, False)
+    with set_current_vllm_config(VllmConfig()):
+        sc = torch.softmax(score, dim=-1, dtype=torch.float32)
+        tw2, tid2 = torch.topk(sc, topk)
+        ref = torch_experts(a, r1, r2, topk_weight=tw2, topk_ids=tid2, global_num_experts=e, expert_map=e_map,
+                            quant_dtype=in_dt, per_act_token_quant=int8)
+        out = fused_marlin_moe(a, q1, q2, None, None, ms1, ms2, tw, tid, global_num_experts=e, expert_map=e_map,
+                               input_global_scale1=g1, input_global_scale2=g2, input_dtype=in_dt, quant_type_id=QT.id)
+    rel = (out.float() - ref.float()).abs().max().item() / ref.float().abs().max().item()
+    assert rel < 0.05, rel
