+def _hc_up_mix(
+    lora: torch.Tensor, weight: torch.Tensor, xn: torch.Tensor, hc: int
+) -> torch.Tensor:
+    shape = (int(weight.shape[0]), int(weight.shape[1]))
+    bucket = m_bucket(lora.shape[0]) or 0
+    cfg = _mix_plans.get(shape, {}).get(bucket)
+    usable = (
+        _usable(lora, weight, shape)
+        and xn.stride(1) == 1
+        and xn.dtype == torch.bfloat16
+    )
+    if cfg is not None and usable:
+        return launch_up_mix(lora, weight, xn, cfg, hc)
+    # No fused plan for this M: the skinny GEMM (when it has a split-free plan,
+    # which needs no scratch slot) or F.linear, then the hc_gate_mix kernel.
+    gcfg = load_plans().get(shape, {}).get(bucket)
+    if gcfg is not None and gcfg[3] == 1 and usable:
+        gate = launch(lora, weight, gcfg, weight, weight)
+    else:
+        gate = torch.nn.functional.linear(lora, weight)
+    return _hc_gate_mix(xn, gate, hc)
+
