+def _hc_down(
+    xn: torch.Tensor, weight: torch.Tensor, slot: int, act_n: int, hc: int
+) -> torch.Tensor:
+    shape, plan, ws, cnt = _slots[slot]
+    cfg = plan.get(m_bucket(xn.shape[0]) or 0)
+    if cfg is None or not _usable(xn, weight, shape):
+        y = torch.nn.functional.linear(xn, weight)
+        y[:, :act_n] = _hc_silu(y[:, :act_n], hc)
