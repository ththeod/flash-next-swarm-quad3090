 # SPDX-FileCopyrightText: Copyright contributors to the vLLM project
 
 
+import os
+
 import torch
 import torch.nn as nn
 
@@ -365,12 +367,54 @@ def compiled_random_sample(logits: torch.Tensor) -> torch.Tensor:
     return probs.div(q).argmax(dim=-1).view(-1)
 
 
+# VLLM_EXP_TOPK_FIRST=1 (2026-10-21): when every row has a top-k <= 64 and the
+# caller knows the largest one (the V2 sampler reads it from host-side state,
+# no sync), take the top max_k values per row with torch.topk and find the
+# top-k / top-p cut-off among them, instead of the Triton kernel's serial sweep
+# of the whole vocab per row (~0.3 ms per decode step for 8 rows of 248K).
+_TOPK_FIRST = os.environ.get("VLLM_EXP_TOPK_FIRST", "0") == "1"
+_TOPK_FIRST_MAX_K = 64
+
+
+def _apply_top_k_first(
+    logits: torch.Tensor, k: torch.Tensor, p: torch.Tensor | None, max_k: int
+) -> torch.Tensor:
+    vals = logits.topk(max_k, dim=-1).values  # [B, max_k], descending
+    last = k.to(torch.long).clamp(1, max_k) - 1  # position of the k-th largest
+    if p is not None:
+        pos = torch.arange(max_k, device=logits.device)
+        in_k = pos.unsqueeze(0) <= last.unsqueeze(1)
+        probs = vals.masked_fill(~in_k, float("-inf")).softmax(dim=-1)
+        # keep a token while the mass of the larger tokens is still below p
+        before = probs.cumsum(dim=-1) - probs
+        keep = in_k & ((before < p.unsqueeze(1)) | (p.unsqueeze(1) >= 1.0))
+        keep[:, 0] = True
+        last = keep.sum(dim=-1) - 1
+    # values-based cut-off: ties with the last kept value stay, as in the
+    # sort-based reference
+    thr = vals.gather(1, last.unsqueeze(1))
+    return logits.masked_fill_(logits < thr, float("-inf"))
+
+
 def apply_top_k_top_p(
-    logits: torch.Tensor, k: torch.Tensor | None, p: torch.Tensor | None
+    logits: torch.Tensor,
+    k: torch.Tensor | None,
+    p: torch.Tensor | None,
+    max_top_k: int | None = None,
 ) -> torch.Tensor:
     if p is None and k is None:
         return logits
 
+    if (
+        _TOPK_FIRST
+        and k is not None
+        and max_top_k is not None
+        and 0 < max_top_k <= _TOPK_FIRST_MAX_K
+        and max_top_k <= logits.shape[-1]
+        and logits.is_cuda
+    ):
+        return _apply_top_k_first(logits, k, p, max_top_k)
+
     if HAS_TRITON:
         return apply_top_k_top_p_triton(logits, k, p)
 
