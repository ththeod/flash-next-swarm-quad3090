From 585485c7ed8e3d5cd01d0de7568f46ad2fa2a9b8 Mon Sep 17 00:00:00 2001
From: ththeod <2376818+ththeod@users.noreply.github.com>
Date: Thu, 22 Oct 2026 12:46:15 +0300
Subject: [PATCH 123/138] Tests: RAM resume reaches the previous turn's tail
 beyond the aligned state; old window kept without a stored prefix

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../offloading_connector/test_scheduler.py    | 82 +++++++++++++++++++
 1 file changed, 82 insertions(+)

diff --git a/tests/v1/kv_connector/unit/offloading_connector/test_scheduler.py b/tests/v1/kv_connector/unit/offloading_connector/test_scheduler.py
index e7a83cb..e6f1229 100644
--- a/tests/v1/kv_connector/unit/offloading_connector/test_scheduler.py
+++ b/tests/v1/kv_connector/unit/offloading_connector/test_scheduler.py
@@ -4666,3 +4666,85 @@ class TestMambaHybridOffloadServing:
             False,
         ]
         assert self._roundtrip_served_tokens(scheduler) == 16
+
+
+def _make_tail_beyond_scan_request(scheduler: OffloadingConnectorScheduler) -> MagicMock:
+    """70-token prompt (17 hashes of 4 tokens, chunks of 16)."""
+    request = MagicMock()
+    request.request_id = "req"
+    request.kv_transfer_params = None
+    request.num_prompt_tokens = 70
+    request.num_tokens = 70
+    request.block_hashes = [BlockHash(f"t{i}".encode()) for i in range(17)]
+    request.all_token_ids = list(range(70))
+    request.lora_request = None
+    request.is_finished.return_value = False
+    request.skip_reading_prefix_cache = False
+    scheduler.on_new_request(request)
+    return request
+
+
+def _hit_only(request, hits):
+    """manager.lookup side effect: HIT for (hash index, group) pairs in `hits`, MISS otherwise."""
+    keys = {make_offload_key(request.block_hashes[h], g) for h, g in hits}
+    return lambda key, *_: LookupResult.HIT if key in keys else LookupResult.MISS
+
+
+def test_partial_lookup_reaches_previous_turn_tail_beyond_aligned_state():
+    """Local 2026-10-22: the previous agent turn left its tail checkpoint at 60 and
+    its attention chunks 0-3 in the store, but a recurrent state only at 16 (the
+    turn that computed 32/48 had a hit beyond them). The tail scan used to cover
+    only (16, 32); it must now start where the stored attention prefix ends."""
+    scheduler = _make_partial_tail_scheduler()
+    request = _make_tail_beyond_scan_request(scheduler)
+    req_status = scheduler._req_status["req"]
+    req_status.num_locally_computed_tokens = 0
+    req_status.update_offload_keys()
+    # attention chunk keys end at hashes 3, 7, 11, 15; Mamba aligned state at 16 (hash 3);
+    # tail checkpoint at 60 = hash 14 for both groups
+    scheduler.manager.lookup.side_effect = _hit_only(
+        request, [(3, 0), (7, 0), (11, 0), (15, 0), (3, 1), (14, 0), (14, 1)]
+    )
+
+    assert scheduler._lookup(req_status) == 60
+    assert req_status.partial_tail_boundary == 60
+
+    scheduler.update_state_after_alloc(
+        request,
+        KVCacheBlocks(
+            (
+                [KVCacheBlock(31), KVCacheBlock(32), KVCacheBlock(33), KVCacheBlock(34)],
+                [KVCacheBlock(0, is_null=True)] * 3 + [KVCacheBlock(41)],
+            )
+        ),
+        num_external_tokens=60,
+    )
+    [(job_id, load_job)] = scheduler._current_batch_load_jobs.items()
+    assert load_job.dst_spec.block_ids.tolist() == [31, 32, 33, 34, 41]
+    assert load_job.dst_spec.group_sizes == [4, 1]
+    assert load_job.dst_spec.block_indices == [0, 3]
+    hb = request.block_hashes
+    assert scheduler._jobs[job_id].keys == {
+        make_offload_key(hb[3], 0), make_offload_key(hb[7], 0), make_offload_key(hb[11], 0),
+        make_offload_key(hb[14], 0), make_offload_key(hb[14], 1),
+    }
+    # the tail's chunk (index 3) is only partly loaded: the attention group must store it
+    # once it fills; the recurrent group keeps the old index
+    attn_state, mamba_state = req_status.group_states
+    assert attn_state.next_stored_chunk_idx == 3
+    assert mamba_state.next_stored_chunk_idx == 4
+
+
+def test_partial_lookup_without_stored_attention_prefix_keeps_old_window():
+    """Only attention chunk 0 is stored: the scan falls back to (16, 32) as before."""
+    scheduler = _make_partial_tail_scheduler()
+    request = _make_tail_beyond_scan_request(scheduler)
+    req_status = scheduler._req_status["req"]
+    req_status.num_locally_computed_tokens = 0
+    req_status.update_offload_keys()
+    # tail at 28 (hash 6) is in the old window; a tail at 60 must not be used without chunks 1-3
+    scheduler.manager.lookup.side_effect = _hit_only(
+        request, [(3, 0), (3, 1), (6, 0), (6, 1), (14, 0), (14, 1)]
+    )
+    assert scheduler._lookup(req_status) == 28
+    assert req_status.partial_tail_boundary == 28
