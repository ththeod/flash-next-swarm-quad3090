+    def _attention_prefix_end(
+        self, req_status: RequestOffloadState, complete_boundary: int, cap: int
+    ) -> int:
+        """End of the prefix whose chunk-level groups (attention) are all in the
+        offload store, walking forward from the complete hit. Recurrent groups are
+        skipped: a partial-tail hit loads only their state at the tail boundary.
+        (local 2026-10-22: the complete hit stops at the newest Mamba-aligned key,
+        one to two blocks before the previous turn's tail, which made that tail
+        unreachable and sent RAM resumes back to an older aligned state.)"""
+        block = self._partial_tail_block_size
+        end = round_down(cap, block)
+        for group_config, group_state in zip(
+            self.config.kv_group_configs, req_status.group_states
+        ):
+            if group_config.sliding_window_size_in_chunks is not None:
+                continue
+            tokens_per_chunk = group_config.tokens_per_chunk
+            keys = group_state.offload_keys
+            idx = complete_boundary // tokens_per_chunk
+            while (
+                (idx + 1) * tokens_per_chunk <= end
+                and idx < len(keys)
+                and self.manager.lookup(keys[idx], req_status.req_context)
+                is LookupResult.HIT
+            ):
+                idx += 1
+            end = min(end, idx * tokens_per_chunk)
+        return max(complete_boundary, end)
+
+    def _tail_candidates(
+        self, req_status: RequestOffloadState, complete_boundary: int, cap: int
+    ) -> Iterator[int]:
+        """Partial-tail boundaries to try, newest first: the block where the stored
+        attention prefix ends and the block before it, then (as before the local
+        change) the block right after the complete hit."""
+        block = self._partial_tail_block_size
+        step = self.config.tokens_per_hash
+        anchor = self._attention_prefix_end(req_status, complete_boundary, cap)
+        starts = [anchor]
+        if anchor - block >= complete_boundary:
+            starts.append(anchor - block)
+        if complete_boundary not in starts:
+            starts.append(complete_boundary)
+        for start in starts:
+            top = round_down(min(cap, start + block - 1), step)
+            yield from range(top, start, -step)
+
     def on_new_request(self, request: Request) -> None:
