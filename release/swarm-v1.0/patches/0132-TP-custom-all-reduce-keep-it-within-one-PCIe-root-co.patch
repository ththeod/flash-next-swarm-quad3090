 # SPDX-License-Identifier: Apache-2.0
 # SPDX-FileCopyrightText: Copyright contributors to the vLLM project
 
+import os
 from contextlib import contextmanager
 from typing import cast
 
@@ -33,6 +34,31 @@ except ImportError:
 logger = init_logger(__name__)
 
 
+def _pcie_root(physical_device_id: int) -> str | None:
+    """The PCIe root complex (sysfs ``pciDDDD:BB``) a GPU hangs off, or None."""
+    try:
+        from vllm.platforms.cuda import pynvml
+
+        pynvml.nvmlInit()
+        try:
+            handle = pynvml.nvmlDeviceGetHandleByIndex(physical_device_id)
+            bus_id = pynvml.nvmlDeviceGetPciInfo(handle).busId
+        finally:
+            pynvml.nvmlShutdown()
+        if isinstance(bus_id, bytes):
+            bus_id = bus_id.decode()
+        domain, rest = bus_id.lower().split(":", 1)
+        path = os.path.realpath(f"/sys/bus/pci/devices/{int(domain, 16):04x}:{rest}")
+        return next((c for c in path.split("/") if c.startswith("pci")), None)
+    except Exception:  # unknown topology: leave custom all-reduce as configured
+        return None
+
+
+def _spans_pcie_root_complexes(physical_device_ids: list[int]) -> bool:
+    roots = [_pcie_root(i) for i in physical_device_ids]
+    return None not in roots and len(set(roots)) > 1
+
+
 def _has_local_multicast_support(device: torch.device) -> bool:
     """Return whether this CUDA device can allocate multicast memory."""
     if torch_symm_mem is None or not current_platform.is_cuda():
@@ -142,6 +168,8 @@ class CustomAllreduce:
         self._IS_CAPTURING = False
         self._ptr = 0
         self.disabled = True
+        # Messages above this many bytes go to NCCL (0 = only max_size applies).
+        self._e2_max_bytes = envs.VLLM_E2_CUSTOM_AR_MAX_BYTES
         self.mnnvl_buffer = None
         self.mnnvl_handle = None
         self.mnnvl_peer_buffers: list[torch.Tensor] | None = None
@@ -233,6 +261,21 @@ class CustomAllreduce:
             physical_device_ids = [t.item() for t in gather_list]
             assert current_platform.is_cuda_alike()
             fully_connected = current_platform.is_fully_connected(physical_device_ids)
+        if (
+            same_node
+            and not fully_connected
+            and envs.VLLM_E2_CUSTOM_AR_SAME_ROOT
+            and _spans_pcie_root_complexes(physical_device_ids)
+        ):
+            # The one-stage kernel reads the peer's buffer; across PCIe root
+            # complexes those reads run ~4x slower than NCCL (W40), within one
+            # they are on par.
+            logger.info(
+                "Custom allreduce is disabled for GPUs %s: they sit on different "
+                "PCIe root complexes (VLLM_E2_CUSTOM_AR_SAME_ROOT=1); NCCL is used.",
+                physical_device_ids,
+            )
+            return
         if same_node and world_size > 2 and not fully_connected:
             logger.warning(
                 "Custom allreduce is disabled because it's not supported on"
@@ -415,6 +458,8 @@ class CustomAllreduce:
             return False
         # for 4 or more non NVLink-capable GPUs, custom allreduce provides
         # little performance improvement over NCCL.
+        if self._e2_max_bytes and inp_size > self._e2_max_bytes:
+            return False
         if self.world_size == 2 or self.fully_connected:
             return inp_size < self.max_size
         return False
