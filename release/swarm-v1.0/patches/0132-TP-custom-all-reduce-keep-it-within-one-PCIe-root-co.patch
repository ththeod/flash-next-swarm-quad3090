@@ -978,6 +987,20 @@ def _e2_nonneg_seconds(name: str) -> float:
     return value
 
 
+def _e2_nonneg_int(name: str) -> int:
+    """A non-negative integer; unset or "0" means off."""
+    raw = os.environ.get(name)
+    if raw is None:
+        return 0
+    try:
+        value = int(raw)
+    except ValueError:
+        raise ValueError(f"{name} must be a non-negative integer, got {raw!r}") from None
+    if value < 0:
+        raise ValueError(f"{name} must be a non-negative integer, got {raw!r}")
+    return value
+
+
 def _e2_strict_switch(name: str, default: bool = False) -> bool:
     """Parse a fork on/off switch that accepts exactly ``"0"`` and ``"1"``.
 
@@ -2683,6 +2706,11 @@ environment_variables: dict[str, Callable[[], Any]] = {
