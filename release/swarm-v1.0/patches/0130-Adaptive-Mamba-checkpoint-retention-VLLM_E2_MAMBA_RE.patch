+def test_adaptive_retention_follows_capacity_failures(monkeypatch):
+    """(local 2026-10-22) VLLM_E2_MAMBA_RETAIN_ADAPTIVE_S: the first capacity
+    failure switches checkpoint retention off (once), and it comes back on
+    only after that many seconds without another failure."""
+    monkeypatch.setenv("VLLM_E2_MAMBA_RETAIN_ADAPTIVE_S", "45")
+    if hasattr(envs.__getattr__, "cache_clear"):
+        envs.__getattr__.cache_clear()
+    scheduler = create_scheduler(num_blocks=6, block_size=16)
+    calls: list[bool] = []
+
+    def switch(on: bool) -> int:
+        calls.append(on)
+        return 0 if on else 2
+
+    monkeypatch.setattr(scheduler.kv_cache_manager, "set_checkpoint_retention", switch)
+    now = [1000.0]
+    import vllm.v1.core.sched.scheduler as sched_mod
+
+    monkeypatch.setattr(sched_mod.time, "monotonic", lambda: now[0])
+
+    big = create_requests(num_requests=1, num_tokens=160, block_size=16)[0]
+    scheduler.add_request(big)  # 10 blocks; the pool has 5
+    assert not scheduler.schedule().num_scheduled_tokens
+    assert calls == [False]
+    now[0] += 30
+    scheduler.schedule()  # still failing: stays off, failure time refreshed
+    assert calls == [False]
+
+    scheduler.finish_requests(big.request_id, RequestStatus.FINISHED_ABORTED)
+    now[0] += 44
+    scheduler.schedule()
+    assert calls == [False]
+    now[0] += 1.5
+    scheduler.schedule()
+    assert calls == [False, True]
+    now[0] += 100
+    scheduler.schedule()
+    assert calls == [False, True]
+
+
 def test_preemption_re_records_prefix_cache_query():
     """A preempted request re-enters the lookup on resume, so its recomputation
     is counted again into the preempted stats."""
