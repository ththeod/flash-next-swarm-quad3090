+    def set_checkpoint_retention(self, on: bool) -> list[KVCacheBlock]:
+        """(local 2026-10-22) Switch retention at runtime (only where it is
+        configured on). Switching off pops every held checkpoint and returns
+        the blocks for the caller to free: they become ordinary cached free
+        blocks, hit-able until evicted, as after a request finishes. Switching
+        on lets requests hold their next retired state again."""
+        if not self._retain_allowed or on == self._retain_checkpoint:
+            return []
+        self._retain_checkpoint = on
+        if on:
+            return []
+        released = [block for _, block in self._retained_checkpoints.values()]
+        self._retained_checkpoints.clear()
+        return released
