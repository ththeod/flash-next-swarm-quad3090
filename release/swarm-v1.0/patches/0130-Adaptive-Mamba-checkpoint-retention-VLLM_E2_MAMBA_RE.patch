+    def _on_capacity_failure(self) -> bool:
+        """(local 2026-10-22) A request could not get blocks. With adaptive
+        retention, stop holding Mamba checkpoints and free the held ones.
+        Returns whether any block was released (worth retrying now)."""
+        if self._retain_adaptive_s <= 0:
+            return False
+        self._last_capacity_failure = time.monotonic()
+        if not self._retention_on:
+            return False
+        self._retention_on = False
+        released = self.kv_cache_manager.set_checkpoint_retention(False)
+        logger.info(
+            "Adaptive retention: off (capacity queue), released %d checkpoint "
+            "blocks",
+            released,
+        )
+        return released > 0
+
+    def _maybe_resume_retention(self) -> None:
+        """Hold checkpoints again after VLLM_E2_MAMBA_RETAIN_ADAPTIVE_S seconds
+        without a capacity failure."""
+        if (
+            self._retention_on
+            or self._last_capacity_failure is None
+            or time.monotonic() - self._last_capacity_failure < self._retain_adaptive_s
+        ):
+            return
+        self._retention_on = True
+        self.kv_cache_manager.set_checkpoint_retention(True)
+        logger.info(
+            "Adaptive retention: on (no capacity queue for %.0f s)",
+            self._retain_adaptive_s,
+        )
