@@ -951,6 +957,20 @@ def _resolve_rust_cli_path() -> str | None:
     return raw
 
 
+def _e2_nonneg_seconds(name: str) -> float:
+    """A non-negative, finite number of seconds; unset or "0" means off."""
+    raw = os.environ.get(name)
+    if raw is None:
+        return 0.0
+    try:
+        value = float(raw)
+    except ValueError:
+        value = -1.0
+    if not (0.0 <= value < float("inf")):
+        raise ValueError(f"{name} must be a non-negative number of seconds, got {raw!r}")
+    return value
+
+
 def _e2_strict_switch(name: str, default: bool = False) -> bool:
     """Parse a fork on/off switch that accepts exactly ``"0"`` and ``"1"``.
 
@@ -2648,6 +2668,10 @@ environment_variables: dict[str, Callable[[], Any]] = {
     "VLLM_E2_MAMBA_RETAIN_CHECKPOINT": lambda: _e2_strict_switch(
         "VLLM_E2_MAMBA_RETAIN_CHECKPOINT", default=True
     ),
+    # Adaptive retention hold-off in seconds (local; 0 = off). Read by the scheduler.
+    "VLLM_E2_MAMBA_RETAIN_ADAPTIVE_S": lambda: _e2_nonneg_seconds(
+        "VLLM_E2_MAMBA_RETAIN_ADAPTIVE_S"
+    ),
     # Side-cache layout (v2.5; PLE state folded into a GDN group + QSA ring slot
     # packing), default ON. Strict "0"/"1"; read once per get_kv_cache_configs call.
     "VLLM_E2_SIDE_CACHE_LAYOUT": lambda: _e2_strict_switch(
@@ -2932,6 +2956,7 @@ def compile_factors() -> dict[str, object]:
         # compiled and the worker's tables are identical in both worlds, so an
         # A/B flip must reuse the same AOT cache.
         "VLLM_E2_MAMBA_RETAIN_CHECKPOINT",
+        "VLLM_E2_MAMBA_RETAIN_ADAPTIVE_S",
         # Boot-failure policy of a host-side profiling-teardown check; read by no
         # compiled code.
         "VLLM_FAIL_ON_PROFILING_KV_LEAK",
