+# --------------------------------------------------------------------------
+# (local 2026-10-22) Adaptive retention: runtime switch.
+# --------------------------------------------------------------------------
+def _held_ids(manager: KVCacheManager) -> set[int]:
+    return {
+        b.block_id
+        for gid in MAMBA_GROUPS
+        for _, b in _mamba(manager, gid)._retained_checkpoints.values()
+    }
+
+
+def test_runtime_switch_releases_held_checkpoints_and_resumes(retain):
+    """Switching retention off mid-request frees the held checkpoints into the
+    cached free queue (still hashed, hit-able until evicted) and stops new
+    holds; switching it back on holds the next retired state again. Without
+    configured retention the switch is a no-op."""
+    manager = _manager(num_blocks=64)
+    pool = manager.block_pool
+    a = _request("A", _tokens(1, 150))
+    _prefill(manager, a)
+    _decode(manager, a, steps=6)
+    held = _held_ids(manager)
+    assert len(held) == (len(MAMBA_GROUPS) if retain else 0)
+
+    free_before = pool.get_num_free_blocks()
+    assert manager.set_checkpoint_retention(False) == len(held)
+    assert pool.get_num_free_blocks() == free_before + len(held)
+    assert not _held_ids(manager)
+    for bid in held:
+        assert _hashed_cached(manager, pool.blocks[bid])
+
+    # Decode across block boundaries: retired states are released, not held.
+    _decode(manager, a, steps=3 * BLOCK, accepted=lambda step: 0)
+    assert not _held_ids(manager)
+    assert manager.set_checkpoint_retention(False) == 0  # idempotent
+
+    # Back on: holds are taken where a request's replay-boundary state retires
+    # (its prefill / resume), so the next request (or A's next turn) holds.
+    assert manager.set_checkpoint_retention(True) == 0
+    b = _request("B", _tokens(2, 150))
+    _prefill(manager, b)
+    _decode(manager, b, steps=6)
+    for gid in MAMBA_GROUPS:
+        assert ("B" in _mamba(manager, gid)._retained_checkpoints) is retain
+        assert "A" not in _mamba(manager, gid)._retained_checkpoints
+
+    manager.free(a)
+    manager.free(b)
+    assert pool.get_num_free_blocks() == pool.num_gpu_blocks - 1  # nothing leaked
