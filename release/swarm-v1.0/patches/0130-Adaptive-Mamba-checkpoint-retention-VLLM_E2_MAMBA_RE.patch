         self.block_pool.free_blocks(reversed(blocks))
         return len(blocks)
 
+    def set_checkpoint_retention(self, on: bool) -> int:
+        """(local 2026-10-22) Switch Mamba prefix-checkpoint retention at
+        runtime (adaptive retention). Switching off frees every held
+        checkpoint into the cached free queue; returns the number of blocks
+        released."""
+        released: list[KVCacheBlock] = []
+        for manager in self.coordinator.single_type_managers:
+            if isinstance(manager, MambaManager):
+                released.extend(manager.set_checkpoint_retention(on))
+        if released:
+            self.block_pool.free_blocks(released)
+        return len(released)
