From e6e48a369c1942dcfe0e074a32b206006577bcdd Mon Sep 17 00:00:00 2001
From: ththeod <2376818+ththeod@users.noreply.github.com>
Date: Thu, 22 Oct 2026 13:26:25 +0300
Subject: [PATCH 125/138] RAM tier: count deferred lookups by reason (own
 transfers, backend pending, being loaded, tail pending)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../kv_connector/v1/offloading/metrics.py       | 17 +++++++++++++++++
 .../kv_connector/v1/offloading/scheduler.py     |  9 +++++++++
 2 files changed, 26 insertions(+)

diff --git a/vllm/distributed/kv_transfer/kv_connector/v1/offloading/metrics.py b/vllm/distributed/kv_transfer/kv_connector/v1/offloading/metrics.py
index 7ec9136..caa2522 100644
--- a/vllm/distributed/kv_transfer/kv_connector/v1/offloading/metrics.py
+++ b/vllm/distributed/kv_transfer/kv_connector/v1/offloading/metrics.py
@@ -41,6 +41,11 @@ class _ConnectorMetricName:
     STORED_ROWS_BOUNDARY = "vllm:kv_offload_stored_rows_boundary"
     STORED_ROWS_TAIL = "vllm:kv_offload_stored_rows_tail"
     DISCARDED_ROWS = "vllm:kv_offload_discarded_rows"
+    # local: why a lookup was deferred (returned None)
+    DEFER_OWN_TRANSFERS = "vllm:kv_offload_defer_own_transfers"
+    DEFER_BACKEND_PENDING = "vllm:kv_offload_defer_backend_pending"
+    DEFER_BEING_LOADED = "vllm:kv_offload_defer_being_loaded"
+    DEFER_TAIL_PENDING = "vllm:kv_offload_defer_tail_pending"
 
 
 class _TransferType:
@@ -143,6 +148,18 @@ def get_connector_metric_definitions() -> dict[str, OffloadingMetricMetadata]:
         _ConnectorMetricName.DISCARDED_ROWS: OffloadingCounterMetadata(
             documentation="Offload rows dropped as superseded tail checkpoints.",
         ),
+        _ConnectorMetricName.DEFER_OWN_TRANSFERS: OffloadingCounterMetadata(
+            documentation="Lookups deferred: the request still has transfers in flight.",
+        ),
+        _ConnectorMetricName.DEFER_BACKEND_PENDING: OffloadingCounterMetadata(
+            documentation="Lookups deferred: a hit chunk is not ready yet (store in flight).",
+        ),
+        _ConnectorMetricName.DEFER_BEING_LOADED: OffloadingCounterMetadata(
+            documentation="Lookups deferred: a hit chunk is being loaded by another request.",
+        ),
+        _ConnectorMetricName.DEFER_TAIL_PENDING: OffloadingCounterMetadata(
+            documentation="Lookups deferred: a partial-tail checkpoint is not ready yet.",
+        ),
     }
 
 
diff --git a/vllm/distributed/kv_transfer/kv_connector/v1/offloading/scheduler.py b/vllm/distributed/kv_transfer/kv_connector/v1/offloading/scheduler.py
index 84b36d1..461ba67 100644
--- a/vllm/distributed/kv_transfer/kv_connector/v1/offloading/scheduler.py
+++ b/vllm/distributed/kv_transfer/kv_connector/v1/offloading/scheduler.py
@@ -934,6 +934,7 @@ class OffloadingConnectorScheduler:
                 "Offloading manager delayed request %s as backend requested",
                 req_status.req.request_id,
             )
+            self._count_defer(_ConnectorMetricName.DEFER_BACKEND_PENDING)
             return None
 
         # Possibly delay the request if any hit chunk is already being loaded.
@@ -960,6 +961,7 @@ class OffloadingConnectorScheduler:
                         " chunks are already being loaded",
                         req_status.req.request_id,
                     )
+                    self._count_defer(_ConnectorMetricName.DEFER_BEING_LOADED)
                     return None
 
         logger.debug(
@@ -971,6 +973,11 @@ class OffloadingConnectorScheduler:
 
         return num_hit_tokens
 
+    def _count_defer(self, name: str) -> None:
+        stats = getattr(self, "_connector_stats", None)
+        if stats is not None:
+            stats.increase_counter(name)
+
     def _superseded_tail(
         self, req_status: RequestOffloadState, boundary: int
     ) -> tuple[int, list[OffloadKey]] | None:
@@ -1089,6 +1096,7 @@ class OffloadingConnectorScheduler:
                 return boundary - local_tokens
 
         if pending and complete_hit == 0:
+            self._count_defer(_ConnectorMetricName.DEFER_TAIL_PENDING)
             return None
         return complete_hit
 
@@ -1185,6 +1193,7 @@ class OffloadingConnectorScheduler:
                 "Delaying request %s since it still has in-flight transfers",
                 request.request_id,
             )
+            self._count_defer(_ConnectorMetricName.DEFER_OWN_TRANSFERS)
             return None, False
 
         req_status.update_offload_keys()
-- 
2.53.0

