+# --- local experiment: FP4 main-KV fake quantization --------------------------
+# VLLM_EXP_QSA_KV_FP4_FAKE=1 rounds K/V, right before the cache write, to what a
+# DeepSeek-V4.1-style FP4 main KV can hold: E2M1 values with one E4M3 scale per
+# 16 consecutive elements of head_dim and no global scale. Storage stays the
+# production FP8 cache (the rounded values are re-quantized by the normal FP8
+# writer), so this only measures the quality cost; it saves no memory. The
+# extra FP8 rounding on top makes it slightly pessimistic vs real FP4 storage.
+_QSA_KV_FP4_FAKE = os.environ.get("VLLM_EXP_QSA_KV_FP4_FAKE", "0") == "1"
+_FP4_GROUP = 16
+_FP4_E2M1_MAX = 6.0
+_fp4_tables: dict[torch.device, tuple[torch.Tensor, torch.Tensor]] = {}
+
+
+def _fp4_e2m1_tables(device: torch.device) -> tuple[torch.Tensor, torch.Tensor]:
+    tables = _fp4_tables.get(device)
+    if tables is None:
+        # Round to nearest E2M1 magnitude {0, .5, 1, 1.5, 2, 3, 4, 6}: the
+        # boundaries are the midpoints. Allocated on the first (eager) forward.
+        boundaries = torch.tensor(
+            [0.25, 0.75, 1.25, 1.75, 2.5, 3.5, 5.0], dtype=torch.float32, device=device
+        )
+        values = torch.tensor(
+            [0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0], dtype=torch.float32, device=device
+        )
+        tables = (boundaries, values)
+        _fp4_tables[device] = tables
+    return tables
+
+
+def _fp4_fake_quant(x: torch.Tensor) -> torch.Tensor:
+    """[T, H, D] BF16 -> the same values rounded through per-16 E2M1 x E4M3 scale."""
+    boundaries, values = _fp4_e2m1_tables(x.device)
+    shape = x.shape
+    g = x.float().reshape(*shape[:-1], shape[-1] // _FP4_GROUP, _FP4_GROUP)
+    absmax = g.abs().amax(dim=-1, keepdim=True)
+    scale = (absmax / _FP4_E2M1_MAX).to(torch.float8_e4m3fn).float()
+    scale = torch.where(scale > 0, scale, torch.ones_like(scale))
+    q = values[torch.bucketize((g / scale).abs(), boundaries)]
+    return (torch.sign(g) * q * scale).reshape(shape).to(x.dtype)
+# ------------------------------------------------------------------------------
+
 _QSA_FP8_CACHE_DTYPES = ("fp8", "fp8_e4m3")
 _QSA_SUPPORTED_CACHE_DTYPES = ("auto", "bfloat16", *_QSA_FP8_CACHE_DTYPES)
 
@@ -811,6 +852,9 @@ class Qwen4ExpQSAAttention(Qwen3NextAttention, AttentionLayerBase):
             self.kv_cache_dtype
         ):
             _qsa_clip_count(self, key, value, main_metadata.slot_mapping)
+        if _QSA_KV_FP4_FAKE:
