     hf_to_vllm_mapper = Qwen3_5Model.hf_to_vllm_mapper | _EXTRA_WEIGHTS_MAPPER
+    # local (DFlash 2 experiment): auxiliary hidden states for a DFlash/EAGLE-3
+    # style drafter. Each capture is the materialized multi-stream state after a
+    # layer, averaged over the hc_count streams ([T, H]), which is what
+    # incoai/Qwen3.8-Flash-Next-DFlash2 was trained on (its SGLang capture
+    # patch). Captures made on an earlier PP stage ride in the intermediate
+    # tensors as aux_hidden_states_<i> (EagleModelMixin layout).
+    supports_aux_hidden_states_over_pp = True
+
+    def _aux_capture(
+        self,
+        layer: nn.Module,
+        hidden_states: torch.Tensor,
+        block_output: torch.Tensor | None,
+        injection: torch.Tensor | None,
+    ) -> torch.Tensor:
+        # The HC combine is delayed into the next layer; materialize it out of
+        # place (hc_combine does not mutate its inputs) for the capture only.
+        if block_output is not None:
+            hidden_states = layer.mlp_hyper_connection.combine(
+                hidden_states, block_output, injection
+            )
+        return hidden_states.unflatten(
+            -1, (self.config.hc_count, self.config.hidden_size)
+        ).mean(dim=-2)
 
