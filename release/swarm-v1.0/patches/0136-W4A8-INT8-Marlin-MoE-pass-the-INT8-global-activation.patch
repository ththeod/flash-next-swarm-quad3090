From e25d5ea1b586c86d459d89c72b56a4c836d45b8d Mon Sep 17 00:00:00 2001
From: ththeod <2376818+ththeod@users.noreply.github.com>
Date: Fri, 23 Oct 2026 01:35:57 +0300
Subject: [PATCH 136/138] W4A8-INT8 Marlin MoE: pass the INT8 global activation
 scales from compressed-tensors WNA16

marlin_act_int8_process_scales splits grouped weight scales into int16 group
scales and one global factor per tensor; the kernel applies that factor only
through the activation global scales. auto_awq passes them, the
compressed-tensors WNA16 MoE method did not, so with
VLLM_MARLIN_INPUT_DTYPE=int8 every expert output was scaled by
~max(scale)/4096 and the model produced noise (W45).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../test_ct_wna16_moe_int8_gscale.py          | 34 +++++++++++++++++++
 .../compressed_tensors_moe_wna16.py           |  7 ++++
 2 files changed, 41 insertions(+)
 create mode 100644 tests/quantization/test_ct_wna16_moe_int8_gscale.py

diff --git a/tests/quantization/test_ct_wna16_moe_int8_gscale.py b/tests/quantization/test_ct_wna16_moe_int8_gscale.py
new file mode 100644
index 0000000..829f8aa
--- /dev/null
+++ b/tests/quantization/test_ct_wna16_moe_int8_gscale.py
@@ -0,0 +1,34 @@
+# SPDX-License-Identifier: Apache-2.0
+"""W4A8-INT8 Marlin MoE (local 2026-10-23, W45): the compressed-tensors WNA16 MoE method must hand the INT8 global
+activation scales to the kernel's quant config (auto_awq already does); without them the expert outputs were scaled by
+~max(weight scale)/4096 and the model produced noise."""
+from types import SimpleNamespace
+
+import torch
+
+from vllm.model_executor.layers.fused_moe.oracle.int_wna16 import WNA16MoEBackend
+from vllm.model_executor.layers.quantization.compressed_tensors.compressed_tensors_moe.compressed_tensors_moe_wna16 import (  # noqa: E501
+    CompressedTensorsWNA16MoEMethod,
+)
+
+
+def _method():
+    m = object.__new__(CompressedTensorsWNA16MoEMethod)
+    m.wna16_backend = WNA16MoEBackend.MARLIN
+    m.group_size, m.num_bits = 128, 4
+    return m
+
+
+def _layer(**extra):
+    return SimpleNamespace(w13_weight_scale=torch.ones(2, 20, 1280), w2_weight_scale=torch.ones(2, 5, 2560), **extra)
+
+
+def test_int8_global_scales_reach_the_quant_config():
+    g1, g2 = torch.tensor(2.1e-5), torch.tensor(1.7e-5)
+    cfg = _method().get_fused_moe_quant_config(_layer(w13_input_global_scale=g1, w2_input_global_scale=g2))
+    assert cfg.a1_gscale is g1 and cfg.a2_gscale is g2
+
+
+def test_bf16_activations_have_no_global_scales():
+    cfg = _method().get_fused_moe_quant_config(_layer())
+    assert cfg.a1_gscale is None and cfg.a2_gscale is None
diff --git a/vllm/model_executor/layers/quantization/compressed_tensors/compressed_tensors_moe/compressed_tensors_moe_wna16.py b/vllm/model_executor/layers/quantization/compressed_tensors/compressed_tensors_moe/compressed_tensors_moe_wna16.py
index 7a5b2d9..1010d2c 100644
--- a/vllm/model_executor/layers/quantization/compressed_tensors/compressed_tensors_moe/compressed_tensors_moe_wna16.py
+++ b/vllm/model_executor/layers/quantization/compressed_tensors/compressed_tensors_moe/compressed_tensors_moe_wna16.py
@@ -506,6 +506,13 @@ class CompressedTensorsWNA16MoEMethod(CompressedTensorsMoEMethod):
             num_bits=self.num_bits,
             w1_zp=getattr(layer, "w13_weight_zero_point", None),
             w2_zp=getattr(layer, "w2_weight_zero_point", None),
+            # W4A8-INT8 Marlin (VLLM_MARLIN_INPUT_DTYPE=int8) splits grouped weight
+            # scales into int16 group scales and one global factor per tensor
+            # (marlin_act_int8_process_scales); the kernel only sees that factor
+            # through the activation global scales. auto_awq passes it; without it
+            # every expert output was off by ~max(scale)/4096 (garbage, W45).
+            a1_gscale=getattr(layer, "w13_input_global_scale", None),
+            a2_gscale=getattr(layer, "w2_input_global_scale", None),
             gemm1_clamp_limit=getattr(layer, "swiglu_limit", None),
             gemm1_alpha=getattr(layer, "swiglu_alpha", None),
             gemm1_beta=getattr(layer, "swiglu_beta", None),
