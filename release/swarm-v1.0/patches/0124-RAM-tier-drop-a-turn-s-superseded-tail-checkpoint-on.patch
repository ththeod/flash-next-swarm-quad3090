diff --git a/vllm/v1/kv_offload/cpu/manager.py b/vllm/v1/kv_offload/cpu/manager.py
index 535c149..ee2bcef 100644
--- a/vllm/v1/kv_offload/cpu/manager.py
+++ b/vllm/v1/kv_offload/cpu/manager.py
@@ -284,6 +284,27 @@ class CPUOffloadingManager(OffloadingManager):
                 )
             )
 
+    @override
+    def discard(
+        self, keys: Collection[OffloadKey], req_context: ReqContext
+    ) -> list[OffloadKey]:
+        removed: list[OffloadKey] = []
+        for key in keys:
+            chunk = self._policy.get(key)
+            # ref_cnt -1: store in flight; > 0: load in flight
+            if chunk is None or chunk.ref_cnt != 0:
+                continue
+            self._policy.remove(key)
+            self._num_evictable_cache_chunks -= 1
+            assert self._num_evictable_cache_chunks >= 0
+            self._free_chunk(chunk)
+            removed.append(key)
+        if removed and self.events is not None:
+            self.events.append(
+                OffloadingEvent(keys=removed, medium=self.medium, removed=True)
+            )
+        return removed
+
     @override
     def reset_cache(self) -> None:
