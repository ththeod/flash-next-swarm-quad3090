@@ -963,6 +971,49 @@ class OffloadingConnectorScheduler:
 
         return num_hit_tokens
 
+    def _superseded_tail(
+        self, req_status: RequestOffloadState, boundary: int
+    ) -> tuple[int, list[OffloadKey]] | None:
+        """(local 2026-10-22) An agent turn resumes from the previous turn's tail
+        checkpoint and stores its own, later one: the old checkpoint (one row per
+        group) can then only serve a request ending exactly there. Returns its
+        keys, once per request."""
+        start = req_status.resume_boundary
+        if (
+            not _DISCARD_SUPERSEDED
+            or not start
+            or start % self._partial_tail_block_size == 0
+            or start >= boundary
+        ):
+            return None
+        req_status.resume_boundary = 0
+        return start, [
+            self._make_boundary_key(req_status.req, group.group_idx, start)
+            for group in self.config.kv_group_configs
+        ]
+
+    def _discard_superseded(
+        self, req_status: RequestOffloadState, start: int, keys: list[OffloadKey]
+    ) -> None:
+        if self._chunks_being_loaded and any(
+            key in self._chunks_being_loaded for key in keys
+        ):
+            return
+        # another live request with the same prefix may still resume there
+        hash_idx = start // self.config.tokens_per_hash - 1
+        own = req_status.req.block_hashes[hash_idx]
+        for other in self._req_status.values():
+            if other is req_status:
+                continue
+            hashes = other.req.block_hashes
+            if len(hashes) > hash_idx and hashes[hash_idx] == own:
+                return
+        removed = self.manager.discard(keys, req_status.req_context)
+        if removed:
+            self._connector_stats.increase_counter(
+                _ConnectorMetricName.DISCARDED_ROWS, len(removed)
+            )
+
     def _make_boundary_key(
         self, request: Request, group_idx: int, boundary_tokens: int
     ) -> OffloadKey:
