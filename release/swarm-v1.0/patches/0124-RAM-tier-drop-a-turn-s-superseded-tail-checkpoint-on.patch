+def test_superseded_tail_is_discarded_once_unless_a_sibling_shares_it():
+    """Local 2026-10-22: a turn that resumed from tail 28 and stores its own tail at
+    60 drops the tail-28 rows (once); a live sibling with the same prefix keeps them."""
+    scheduler = _make_partial_tail_scheduler()
+    request = _make_tail_beyond_scan_request(scheduler)
+    req_status = scheduler._req_status["req"]
+    hb = request.block_hashes
+
+    req_status.resume_boundary = 32          # aligned resume point: not a tail checkpoint
+    assert scheduler._superseded_tail(req_status, 60) is None
+    req_status.resume_boundary = 28
+    assert scheduler._superseded_tail(req_status, 28) is None   # not superseded by itself
+    start, keys = scheduler._superseded_tail(req_status, 60)
+    assert start == 28 and keys == [make_offload_key(hb[6], 0), make_offload_key(hb[6], 1)]
+    assert scheduler._superseded_tail(req_status, 64) is None   # once per request
+
+    scheduler._discard_superseded(req_status, start, keys)
+    scheduler.manager.discard.assert_called_once_with(keys, req_status.req_context)
+
+    scheduler.manager.discard.reset_mock()
+    sibling = MagicMock()
+    sibling.request_id = "sib"
+    sibling.kv_transfer_params = None
+    sibling.num_prompt_tokens = 40
+    sibling.num_tokens = 40
+    sibling.block_hashes = list(hb[:10])
+    sibling.all_token_ids = list(range(40))
+    sibling.lora_request = None
+    sibling.is_finished.return_value = False
+    scheduler.on_new_request(sibling)
+    scheduler._discard_superseded(req_status, start, keys)
+    scheduler.manager.discard.assert_not_called()
diff --git a/tests/v1/kv_offload/cpu/test_manager.py b/tests/v1/kv_offload/cpu/test_manager.py
index a79f480..2157ef7 100644
--- a/tests/v1/kv_offload/cpu/test_manager.py
+++ b/tests/v1/kv_offload/cpu/test_manager.py
@@ -1156,3 +1156,34 @@ def test_touch_forwards_req_context_to_policy(monkeypatch):
     assert len(received) == 1
     assert received[0][0] == keys
     assert received[0][1] is ctx
+
+
+@pytest.mark.parametrize("eviction_policy", ["lru", "arc"])
+def test_discard_frees_idle_chunks_and_keeps_busy_ones(eviction_policy):
+    """Local 2026-10-22: superseded tail checkpoints are dropped, never while a
+    store or a load is in flight on them."""
+    manager = make_cpu_manager(num_chunks=4, cache_policy=eviction_policy, enable_events=True)
+    k = [make_offload_key(f"d{i}".encode(), 0) for i in range(4)]
+    manager.prepare_store(k[:3], _EMPTY_REQ_CTX)
+    manager.complete_store(k[:2], _EMPTY_REQ_CTX)  # k0, k1 stored; k2 still being written
+    list(manager.take_events())
+    manager.prepare_load([k[1]], _EMPTY_REQ_CTX)    # k1 being read
+
+    assert manager.discard([k[0], k[1], k[2], k[3]], _EMPTY_REQ_CTX) == [k[0]]
+    assert manager.lookup(k[0], _EMPTY_REQ_CTX) is LookupResult.MISS
+    assert manager.lookup(k[1], _EMPTY_REQ_CTX) is LookupResult.HIT
+    [event] = list(manager.take_events())
+    assert event.removed and list(event.keys) == [k[0]]
+
+    # the freed slot is reused without eviction; the busy ones are kept
+    out = manager.prepare_store([k[3]], _EMPTY_REQ_CTX)
+    assert out is not None and out.keys_to_store == [k[3]] and not out.evicted_keys
+    manager.complete_load([k[1]], _EMPTY_REQ_CTX)
+    manager.complete_store([k[2], k[3]], _EMPTY_REQ_CTX)
+    assert manager.discard([k[1]], _EMPTY_REQ_CTX) == [k[1]]
+    # 2 slots free now (k1's and one never used); 3 new keys evict exactly one stored key,
+    # and the evictable count still covers k2 and k3
+    new = [make_offload_key(f"n{i}".encode(), 0) for i in range(3)]
+    out = manager.prepare_store(new, _EMPTY_REQ_CTX)
+    assert out is not None and out.keys_to_store == new and out.evicted_keys == [k[2]]
+    assert manager._num_evictable_cache_chunks == 1
