+# --- local experiment: FP4 main K/V storage (VLLM_EXP_QSA_KV_FP4) -------------
+# DeepSeek-V4.1-style main KV: E2M1 values with one E4M3 scale per 16 elements of
+# head_dim, no global scale. Each K or V row of a (token, kv head) is
+# [head_dim/2 packed bytes: element 2i in the low nibble, 2i+1 in the high]
+# [head_dim/16 E4M3 scale bytes], i.e. 144 B for head_dim 256 (FP8: 256 B).
+QSA_FP4_GROUP = 16
+
+
+def qsa_fp4_row_bytes(head_dim: int) -> int:
+    return head_dim // 2 + head_dim // QSA_FP4_GROUP
+
+
+_unit_scales: dict[torch.device, torch.Tensor] = {}
+
+
+def _unit_scale(device: torch.device) -> torch.Tensor:
+    """Persistent float32 1.0 on `device` (allocated on first use, i.e. in the eager
+    warm-up/profile run, never inside CUDA graph capture)."""
+    t = _unit_scales.get(device)
+    if t is None:
+        t = torch.ones((), dtype=torch.float32, device=device)
+        _unit_scales[device] = t
+    return t
+
+
+@triton.jit
+def _encode_e4m3(x):
+    """fp32 >= 0 -> E4M3 byte, round half up on the dropped mantissa bit,
+    saturating at 448 (0x7E); never emits the NaN codes 0x7F/0xFF."""
+    x = tl.minimum(tl.maximum(x, 0.0), 448.0)
+    bits = x.to(tl.int32, bitcast=True)
+    exp = ((bits >> 23) & 0xFF) - 127
+    mant = bits & 0x7FFFFF
+    m = (mant >> 20) + ((mant >> 19) & 1)
+    exp_n = tl.where(m == 8, exp + 1, exp)
+    m = tl.where(m == 8, 0, m)
+    normal = tl.minimum(((exp_n + 7) << 3) | m, 0x7E)
+    # Below 2^-6 E4M3 is subnormal: multiples of 2^-9 (8 rounds to the first
+    # normal, code 0x08 = 2^-6, by construction).
+    sub = tl.floor(x * 512.0 + 0.5).to(tl.int32)
+    return tl.where(exp < -6, sub, normal).to(tl.uint8)
+
+
+@triton.jit
+def _decode_e2m1(nib):
+    """4-bit E2M1 code (sign bit 3) -> fp32 in {0, .5, 1, 1.5, 2, 3, 4, 6} x sign."""
+    code = nib & 7
+    e = code >> 1
+    m = (code & 1).to(tl.float32)
+    mag = tl.where(e == 0, m * 0.5, tl.exp2((e - 1).to(tl.float32)) * (1.0 + 0.5 * m))
+    return tl.where((nib & 8) != 0, -mag, mag)
+
+
+@triton.jit
+def _fp4_quantize_row(x, HEAD_DIM: tl.constexpr):
+    """[HEAD_DIM] fp32 -> ([HEAD_DIM/2] packed uint8, [HEAD_DIM/16] E4M3 scales)."""
+    g = tl.reshape(x, (HEAD_DIM // 16, 16))
+    amax = tl.max(tl.abs(g), axis=1)
+    scale_code = _encode_e4m3(amax / 6.0)
+    scale = _decode_e4m3_to_bf16(scale_code).to(tl.float32)
+    scale = tl.where(scale > 0.0, scale, 1.0)
+    v = g / scale[:, None]
+    a = tl.abs(v)
+    # Nearest E2M1 magnitude (midpoints; ties go down, like the fake-quant test).
+    code = (
+        (a > 0.25).to(tl.int32) + (a > 0.75).to(tl.int32) + (a > 1.25).to(tl.int32)
+        + (a > 1.75).to(tl.int32) + (a > 2.5).to(tl.int32) + (a > 3.5).to(tl.int32)
+        + (a > 5.0).to(tl.int32)
+    )
+    nib = code | (((v < 0.0) & (code > 0)).to(tl.int32) << 3)
+    lo, hi = tl.split(tl.reshape(nib, (HEAD_DIM // 2, 2)))
+    return (lo | (hi << 4)).to(tl.uint8), scale_code
+
+
+@triton.jit
+def _qsa_fp4_store_kernel(
+    key_ptr,
+    value_ptr,
+    cache_ptr,
+    slot_ptr,
+    stride_key_token,
+    stride_key_head,
+    stride_value_token,
+    stride_value_head,
+    stride_cache_block,
+    stride_cache_head,
+    stride_cache_token,
+    PAGE_SIZE: tl.constexpr,
+    HEAD_DIM: tl.constexpr,
+    ROW_BYTES: tl.constexpr,
+):
+    token = tl.program_id(0)
+    head = tl.program_id(1)
+    slot = tl.load(slot_ptr + token).to(tl.int64)
+    if slot < 0:  # padding rows of a captured batch, like reshape_and_cache_flash
+        return
+    block = slot // PAGE_SIZE
+    offset = slot % PAGE_SIZE
+    base = (
+        cache_ptr
+        + block * stride_cache_block
+        + head * stride_cache_head
+        + offset * stride_cache_token
+    )
+    dims = tl.arange(0, HEAD_DIM)
+    for kv in tl.static_range(2):
+        if kv == 0:
+            x = tl.load(key_ptr + token * stride_key_token + head * stride_key_head + dims)
+        else:
+            x = tl.load(
+                value_ptr + token * stride_value_token + head * stride_value_head + dims
+            )
+        packed, scales = _fp4_quantize_row(x.to(tl.float32), HEAD_DIM)
+        row = base + kv * ROW_BYTES
+        tl.store(row + tl.arange(0, HEAD_DIM // 2), packed)
+        tl.store(row + HEAD_DIM // 2 + tl.arange(0, HEAD_DIM // 16), scales)
+
+
+def qsa_fp4_store_kv(
+    key: torch.Tensor,
+    value: torch.Tensor,
+    kv_cache: torch.Tensor,
+    slot_mapping: torch.Tensor,
+) -> None:
+    """Write K/V rows ([T, H, D] BF16) into an FP4 (B, H, N, 2*row_bytes) uint8 cache.
+    Like reshape_and_cache_flash, the slot mapping's length sets the token count."""
+    num_tokens = slot_mapping.shape[0]
+    if num_tokens == 0:
+        return
+    head_dim = key.shape[-1]
+    row_bytes = qsa_fp4_row_bytes(head_dim)
+    assert kv_cache.dtype == torch.uint8 and kv_cache.shape[-1] == 2 * row_bytes, (
+        f"FP4 QSA cache must be uint8 with last dim {2 * row_bytes}, got "
+        f"{tuple(kv_cache.shape)} {kv_cache.dtype}"
+    )
+    assert key.stride(-1) == value.stride(-1) == 1 and kv_cache.stride(-1) == 1
+    _qsa_fp4_store_kernel[(num_tokens, key.shape[1])](
+        key,
+        value,
+        kv_cache,
+        slot_mapping,
+        key.stride(0),
+        key.stride(1),
+        value.stride(0),
+        value.stride(1),
+        kv_cache.stride(0),
+        kv_cache.stride(1),
+        kv_cache.stride(2),
+        PAGE_SIZE=kv_cache.shape[2],
+        HEAD_DIM=head_dim,
+        ROW_BYTES=row_bytes,
+        num_warps=2,
+    )
+# ------------------------------------------------------------------------------
+
