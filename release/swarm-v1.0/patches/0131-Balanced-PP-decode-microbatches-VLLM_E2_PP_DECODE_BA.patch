diff --git a/tests/v1/core/test_scheduler.py b/tests/v1/core/test_scheduler.py
index 71e8554..1658671 100644
--- a/tests/v1/core/test_scheduler.py
+++ b/tests/v1/core/test_scheduler.py
@@ -6712,3 +6712,47 @@ def test_update_draft_token_ids_in_output_strips_padding():
         -1,
     ]
     assert scheduler_output.num_invalid_spec_tokens == {request.request_id: 2}
+
+
+def _pretend_gpus(monkeypatch, n: int) -> None:
+    """PP configs validate the world size against the visible GPUs; these
+    scheduler-only tests never touch a device."""
+    from vllm.platforms import current_platform
+
+    monkeypatch.setattr(current_platform, "device_count", lambda: n)
+
+
+def _pp2_decode_split(monkeypatch, balance: str) -> list[int]:
+    """Admit 8 requests as 6 + 2 under V2 + PP2 + async scheduling and return
+    the number of decodes scheduled in each of the next 8 steps."""
+    monkeypatch.setenv("VLLM_E2_PP_DECODE_BALANCE", balance)
+    _pretend_gpus(monkeypatch, 2)
+    scheduler = create_scheduler(
+        async_scheduling=True, pipeline_parallel_size=2, use_v2_model_runner=True
+    )
+    requests = create_requests(num_requests=8, num_tokens=8, max_tokens=64)
+    for request in requests[:6]:
+        scheduler.add_request(request)
+    scheduler.schedule()  # 6 whole-prompt prefills
+    for request in requests[6:]:
+        scheduler.add_request(request)
+    scheduler.schedule()  # 2 whole-prompt prefills
+    return [len(scheduler.schedule().num_scheduled_tokens) for _ in range(8)]
+
+
+def test_pp_decode_balance_evens_out_microbatches(monkeypatch):
+    """Decodes alternate between pp_size steps and keep the split admission
+    gave them; VLLM_E2_PP_DECODE_BALANCE caps a step at ceil(decoding /
+    pp_size), so the 6/2 split becomes 4/4 within one cycle."""
+    assert _pp2_decode_split(monkeypatch, "0") == [6, 2] * 4
+    split = _pp2_decode_split(monkeypatch, "1")
+    assert split[0] == 4 and split[2:] == [4] * 6, split
+    assert sum(split[:2]) == 8, split  # nobody is dropped in the switch-over
+
+
+def test_pp_decode_balance_is_off_without_the_decode_cadence(monkeypatch):
+    """Synchronous scheduling has no decode cadence: the cap never applies."""
+    monkeypatch.setenv("VLLM_E2_PP_DECODE_BALANCE", "1")
+    _pretend_gpus(monkeypatch, 2)
+    scheduler = create_scheduler(pipeline_parallel_size=2, use_v2_model_runner=True)
+    assert not scheduler._pp_decode_balance
