+    VLLM_E2_PP_DECODE_BALANCE: bool = False
     # v2.5 side-cache layout (Flash-Next PLE + QSA ring): stop charging each
     # tiny side cache a whole packed pool block per request. The TP-replicated
     # PLE short-conv state group is folded into a GDN group that has a spare
@@ -2672,6 +2679,10 @@ environment_variables: dict[str, Callable[[], Any]] = {
     "VLLM_E2_MAMBA_RETAIN_ADAPTIVE_S": lambda: _e2_nonneg_seconds(
         "VLLM_E2_MAMBA_RETAIN_ADAPTIVE_S"
     ),
+    # Balanced PP decode microbatches (local; default off). Strict "0"/"1"; read by the scheduler.
+    "VLLM_E2_PP_DECODE_BALANCE": lambda: _e2_strict_switch(
+        "VLLM_E2_PP_DECODE_BALANCE", default=False
+    ),
     # Side-cache layout (v2.5; PLE state folded into a GDN group + QSA ring slot
     # packing), default ON. Strict "0"/"1"; read once per get_kv_cache_configs call.
     "VLLM_E2_SIDE_CACHE_LAYOUT": lambda: _e2_strict_switch(
@@ -2957,6 +2968,7 @@ def compile_factors() -> dict[str, object]:
         # A/B flip must reuse the same AOT cache.
         "VLLM_E2_MAMBA_RETAIN_CHECKPOINT",
         "VLLM_E2_MAMBA_RETAIN_ADAPTIVE_S",
+        "VLLM_E2_PP_DECODE_BALANCE",
         # Boot-failure policy of a host-side profiling-teardown check; read by no
         # compiled code.
         "VLLM_FAIL_ON_PROFILING_KV_LEAK",
