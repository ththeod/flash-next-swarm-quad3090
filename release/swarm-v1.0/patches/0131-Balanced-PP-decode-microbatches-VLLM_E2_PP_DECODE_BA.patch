diff --git a/vllm/v1/core/sched/scheduler.py b/vllm/v1/core/sched/scheduler.py
index 1461017..9a0b7bd 100644
--- a/vllm/v1/core/sched/scheduler.py
+++ b/vllm/v1/core/sched/scheduler.py
@@ -87,6 +87,10 @@ _ZERO_OWNERSHIP_CHECK = os.getenv("VLLM_E2_ZERO_OWNERSHIP_CHECK") == "1"
 
 
 class Scheduler(SchedulerInterface):
+    # True on schedulers that pace decodes with `next_decode_eligible_step`
+    # (AsyncScheduler).
+    _decode_cadence = False
+
     def __init__(
         self,
         vllm_config: VllmConfig,
@@ -367,6 +371,15 @@ class Scheduler(SchedulerInterface):
 
         self.use_pp = self.parallel_config.pipeline_parallel_size > 1
         self.use_v2_model_runner = vllm_config.use_v2_model_runner
+        # Balanced PP decode microbatches (VLLM_E2_PP_DECODE_BALANCE). Only
+        # meaningful with the AsyncScheduler's decode cadence
+        # (`next_decode_eligible_step`, V2 runner + PP).
+        self._pp_decode_balance = (
+            envs.VLLM_E2_PP_DECODE_BALANCE
+            and self._decode_cadence
+            and self.use_v2_model_runner
+            and self.parallel_config.pipeline_parallel_size > 1
+        )
         # Scheduler iteration counter. Drives the V2+PP+async decode-throttle
         # cadence (`next_decode_eligible_step`).
         self.current_step = 0
@@ -742,6 +755,19 @@ class Scheduler(SchedulerInterface):
             throttle_prefills and not self.prefill_capacity_bound
         ) and any(not r.is_prefill_chunk for r in self.running)
 
+        # Balanced PP decode microbatches: a request decodes every pp_size
+        # steps, so the decoding requests form pp_size microbatches that keep
+        # whatever split admission gave them (6/2 and 7/1 with 8 requests), and
+        # every step's chain through all stages is paced by the biggest one.
+        # Cap this step's decodes at ceil(decoding / pp_size); a request over
+        # the cap is eligible again next step, which evens the split out.
+        decode_cap = None
+        num_decodes_scheduled = 0
+        if self._pp_decode_balance:
+            num_decoding = sum(1 for r in self.running if not r.is_prefill_chunk)
+            pp_size = self.parallel_config.pipeline_parallel_size
+            decode_cap = (num_decoding + pp_size - 1) // pp_size
+
         # First, schedule the RUNNING requests.
         req_index = 0
         while req_index < len(self.running) and token_budget > 0:
@@ -771,6 +797,15 @@ class Scheduler(SchedulerInterface):
                 req_index += 1
                 continue
 
+            if (
+                decode_cap is not None
+                and not request.is_prefill_chunk
+                and num_decodes_scheduled >= decode_cap
+            ):
+                # Over this step's share of decodes: decode next step instead.
+                req_index += 1
+                continue
+
             if defer_prefills and request.is_prefill_chunk:
                 # DP prefill balancing: defer this in-progress prefill chunk to a
                 # cadence-aligned step; decodes still run to fill this step.
@@ -954,6 +989,7 @@ class Scheduler(SchedulerInterface):
             # Schedule the request.
             scheduled_running_reqs.append(request)
             prefill_scheduled |= request.is_prefill_chunk
+            num_decodes_scheduled += not request.is_prefill_chunk
             request_id = request.request_id
             req_to_new_blocks[request_id] = new_blocks
             num_scheduled_tokens[request_id] = num_new_tokens
