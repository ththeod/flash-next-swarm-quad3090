     VLLM_E2_MAMBA_RETAIN_ADAPTIVE_S: float = 0.0
+    # (local 2026-10-22) V2 + PP + async: cap the decodes scheduled in one step at
+    # ceil(decoding requests / pp_size), deferring the rest by one step, so the
+    # pp_size decode microbatches stay balanced instead of keeping whatever split
+    # admission produced (6/2 and 7/1 seen with 8 requests; each step's chain
+    # through both stages is paced by the biggest microbatch). Scheduler-side
