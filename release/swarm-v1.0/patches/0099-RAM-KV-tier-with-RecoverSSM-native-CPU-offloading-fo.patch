+        # Local fix (offload + MTP corruption on Qwen3.8-Flash-Next / halt95 v2.2): with
+        # speculative decoding whose drafter shares the target's KV groups (no group is
+        # annotated is_eagle_group), the GPU prefix-cache path drops the last matched
+        # block (drop_eagle_block) but the offload lookup did not, so a RAM hit could
+        # resume from the volatile last block's Mamba/GDN state and produce garbage.
+        # Mirror the GPU behaviour: cap offload hits one aligned block earlier.
+        spec_cfg = vllm_config.speculative_config
+        self._eagle_drop_unannotated: bool = bool(
+            os.environ.get("VLLM_OFFLOAD_EAGLE_DROP", "0") == "1"
+            and spec_cfg is not None
+            and spec_cfg.use_eagle_block_drop()
+            and not any(c.is_eagle_group for c in self.config.kv_group_configs)
+        )
+        self._eagle_drop_align: int = (
+            self._mamba_align_size or self.config.tokens_per_hash
+        )
+        if self._eagle_drop_unannotated:
+            logger.info(
+                "KV offloading: applying eagle/MTP last-block drop to offload hits "
+                "(align=%d tokens)", self._eagle_drop_align)
         self._partial_tail_block_size = (
             self.config.kv_group_configs[0].tokens_per_block
