+    def _recoverssm_cpu_offload_allowed(self) -> bool:
+        """Local (Stage 2): RecoverSSM with the native CPU OffloadingConnector.
+
+        Opt-in (VLLM_E2_RECOVERSSM_OFFLOAD=1) and only in the shape that was
+        analysed: prompt-only stores (every stored GDN/PLE boundary is written by
+        prefill, never by a verify row whose commit a non-last PP rank defers),
+        no sparse prefix retention, RecoverSSM proper (Model Runner V2), and on
+        PP the boundary hold and the hit-deferral window set to at least
+        pp_size steps. P/D and every other connector stay rejected."""
+        if os.environ.get("VLLM_E2_RECOVERSSM_OFFLOAD", "0") != "1":
+            return False
+        kvt = self.kv_transfer_config
+        if kvt is None or kvt.kv_connector != "OffloadingConnector":
+            return False
+        extra = kvt.kv_connector_extra_config or {}
+        if not bool(extra.get("offload_prompt_only", True)):
+            raise ValueError(
+                "VLLM_E2_RECOVERSSM_OFFLOAD=1 requires offload_prompt_only=True"
+            )
+        if self.cache_config.prefix_cache_retention_interval not in (0, None):
+            raise ValueError(
+                "VLLM_E2_RECOVERSSM_OFFLOAD=1 requires "
+                "prefix_cache_retention_interval=0"
+            )
+        if not self.use_v2_model_runner:
+            raise ValueError(
+                "VLLM_E2_RECOVERSSM_OFFLOAD=1 requires VLLM_USE_V2_MODEL_RUNNER=1"
+            )
+        pp = self.parallel_config.pipeline_parallel_size
+        if pp > 1:
+            hold = int(os.environ.get("VLLM_E2_BOUNDARY_OFFLOAD_HOLD_STEPS", "0"))
+            defer = int(os.environ.get("VLLM_E2_MAMBA_HIT_DEFER_STEPS", "1"))
+            if hold < pp or defer < pp:
+                raise ValueError(
+                    "VLLM_E2_RECOVERSSM_OFFLOAD=1 with pipeline_parallel_size="
+                    f"{pp} requires VLLM_E2_BOUNDARY_OFFLOAD_HOLD_STEPS and "
+                    f"VLLM_E2_MAMBA_HIT_DEFER_STEPS >= {pp} (got {hold}, {defer})"
+                )
+        logger.warning(
+            "RecoverSSM with the CPU OffloadingConnector (local Stage 2, "
+            "prompt-only stores, boundary hold %s, hit deferral %s steps)",
+            os.environ.get("VLLM_E2_BOUNDARY_OFFLOAD_HOLD_STEPS", "0"),
+            os.environ.get("VLLM_E2_MAMBA_HIT_DEFER_STEPS", "1"),
+        )
+        return True
+
 
 _current_vllm_config: VllmConfig | None = None
