@@ -952,6 +973,26 @@ class OffloadingConnectorScheduler:
         self,
         req_status: RequestOffloadState,
         max_num_new_tokens: int | None = None,
+    ) -> int | None:
+        hit = self._lookup_unadjusted(req_status, max_num_new_tokens)
+        if not hit or not self._eagle_drop_unannotated:
+            return hit
+        # Re-run the lookup capped one aligned block earlier, so every group's
+        # availability (e.g. sparse Mamba checkpoints) is verified at the new end.
+        local = req_status.num_locally_computed_tokens
+        align = self._eagle_drop_align
+        end = round_down(local + hit, align) - align
+        min_chunk = min(c.tokens_per_chunk for c in self.config.kv_group_configs)
+        if end - local < min_chunk:
+            return 0
+        new_hit = self._lookup_unadjusted(req_status, end - local)
+        logger.debug("eagle-drop: offload hit %s -> %s tokens (local %d)", hit, new_hit, local)
+        return new_hit
+
+    def _lookup_unadjusted(
+        self,
+        req_status: RequestOffloadState,
+        max_num_new_tokens: int | None = None,
     ) -> int | None:
         complete_hit = self._lookup_complete_chunks(req_status, max_num_new_tokens)
         req_status.partial_tail_boundary = None
