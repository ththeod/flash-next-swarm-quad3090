+    def _hashed_recently(self, block_hash: BlockHashWithGroupId | None) -> bool:
+        # Upstream: any block hashed this step. Plus (PP + RecoverSSM) a
+        # decode-produced boundary block hashed in the previous steps of the window.
+        if block_hash is None:
+            return False
+        if block_hash in self.cached_blocks_this_step:
+            return True
+        return any(block_hash in s for s in self._recent_decode_hashed_blocks)
+
+    def evict_uncommitted_boundaries(self, request_id: str) -> int:
+        """Drop from the prefix cache the decode-produced boundary blocks this
+        request hashed in the last hold window. Called before an early free
+        (preemption, abort): on a non-last PP rank those blocks' deferred
+        commits are skipped for a freed row, so their bytes there may be stale.
+        A normal finish keeps them (the worker commits before it frees)."""
+        recent = self._recent_decode_hashed.pop(request_id, None)
+        if not recent:
+            return 0
+        horizon = self._boundary_step - self._boundary_hold_steps
+        ids = {b.block_id for st, b in recent if st >= horizon and b.block_hash is not None}
+        if ids:
+            self.block_pool.evict_blocks(ids)
+        return len(ids)
+
+    def _pin_block(self, block: KVCacheBlock) -> None:
+        (getattr(block, "pool", None) or self.block_pool).touch([block])
+
+    def _unpin_block(self, block: KVCacheBlock) -> None:
+        self.block_pool.free_blocks([block])
+
+    def take_pending_boundary_state_offloads(
+        self,
+    ) -> list[tuple[str, int, KVCacheBlock, int]]:
+        pending = super().take_pending_boundary_state_offloads()
+        if not self._held_boundary_offloads:
+            return pending
+        ripe: list[tuple[str, int, KVCacheBlock, int]] = []
+        keep: list[tuple[int, tuple[str, int, KVCacheBlock, int]]] = []
+        for release_step, entry in self._held_boundary_offloads:
+            if release_step <= self._boundary_step:
+                ripe.append(entry)
+            else:
+                keep.append((release_step, entry))
+        self._held_boundary_offloads = keep
+        # Unpinned here, at the end of the scheduling pass: the connector fences
+        # the block (store job) before any later pass can reallocate it.
+        for entry in ripe:
+            self._unpin_block(entry[2])
+        return pending + ripe
 
