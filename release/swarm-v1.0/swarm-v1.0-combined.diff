+
+    scheduler.running.remove(older)
+    # (its in-flight output is dropped, so it may resume right away)
+    scheduler._preempt_request(older, 0.0, drop_stale_output=True)
+    assert list(scheduler.waiting) == [older, newer]
+
+    scheduled = scheduler.schedule().num_scheduled_tokens
