--- /dev/null
+++ b/tests/distributed/test_custom_all_reduce_e2_limits.py
@@ -0,0 +1,41 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Local (2026-10-22) limits on the TP custom all-reduce: VLLM_E2_CUSTOM_AR_MAX_BYTES
+sends larger messages to NCCL, VLLM_E2_CUSTOM_AR_SAME_ROOT keeps it off for GPUs on
+different PCIe root complexes."""
+
+import torch
+
+from vllm.distributed.device_communicators import custom_all_reduce as car
+
+
+def _communicator(max_bytes: int) -> car.CustomAllreduce:
+    communicator = car.CustomAllreduce.__new__(car.CustomAllreduce)
+    communicator.disabled = False
+    communicator.world_size = 2
+    communicator.fully_connected = False
+    communicator.max_size = 8192 * 1024
+    communicator._ptr = 0
+    communicator._e2_max_bytes = max_bytes
+    return communicator
+
+
+def test_max_bytes_sends_larger_messages_to_nccl():
+    small = torch.empty(16, 2560, dtype=torch.bfloat16)  # 80 KB
+    large = torch.empty(48, 2560, dtype=torch.bfloat16)  # 240 KB
+    assert _communicator(0).should_custom_ar(large)
+    limited = _communicator(131072)
+    assert limited.should_custom_ar(small)
+    assert not limited.should_custom_ar(large)
+
+
+def test_spans_pcie_root_complexes(monkeypatch):
+    roots = {0: "pci0000:00", 1: "pci0000:00", 2: "pci0000:20", 3: "pci0000:40"}
+    monkeypatch.setattr(car, "_pcie_root", roots.get)
+    assert not car._spans_pcie_root_complexes([0, 1])
+    assert car._spans_pcie_root_complexes([2, 3])
+    assert car._spans_pcie_root_complexes([1, 2])
+
+
+def test_unknown_topology_keeps_custom_all_reduce(monkeypatch):
+    monkeypatch.setattr(car, "_pcie_root", lambda i: None if i == 3 else "pci0000:00")
+    assert not car._spans_pcie_root_complexes([2, 3])
