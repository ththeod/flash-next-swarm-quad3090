+# --- local: segmented, cached prompt tokenization (deepseek-recipe idea) -------
+# VLLM_EXP_SEG_TOKENIZE=1: long chat prompts are split before each
+# "<|im_start|>" (a special token, so the tokenizer never merges across it and
+# per-segment encoding is exact), only segments not seen before are encoded,
+# in one parallel encode_batch, and segment ids are kept in an LRU bounded by
+# VLLM_EXP_SEG_TOKENIZE_TOKENS (default 8M tokens). Agent turns resend the same
+# earlier messages, so most of a 100K+ token prompt is a cache hit.
+# VLLM_EXP_SEG_TOKENIZE_VERIFY=1 also runs the normal path and logs/uses it on
+# any mismatch (for testing).
+import collections as _collections
+import os as _os
+import threading as _threading
+
+import numpy as _np
+
+_SEG_TOKENIZE = _os.environ.get("VLLM_EXP_SEG_TOKENIZE", "0") == "1"
+_SEG_VERIFY = _os.environ.get("VLLM_EXP_SEG_TOKENIZE_VERIFY", "0") == "1"
+_SEG_BUDGET = int(_os.environ.get("VLLM_EXP_SEG_TOKENIZE_TOKENS", str(8 << 20)))
+_SEG_MIN_CHARS = 16384
+_SEG_SEP = "<|im_start|>"
+
+
+class _SegmentTokenCache:
+    def __init__(self, budget_tokens: int) -> None:
+        self.budget = budget_tokens
+        self.tokens = 0
+        self.items: _collections.OrderedDict[str, _np.ndarray] = (
+            _collections.OrderedDict()
+        )
+        self.lock = _threading.Lock()
+        self.hits = self.misses = 0
+
+    def get_many(self, segs: list[str]) -> list[_np.ndarray | None]:
+        out: list[_np.ndarray | None] = []
+        with self.lock:
+            for s in segs:
+                ids = self.items.get(s)
+                if ids is not None:
+                    self.items.move_to_end(s)
+                    self.hits += 1
+                else:
+                    self.misses += 1
+                out.append(ids)
+        return out
+
+    def put_many(self, segs: list[str], ids: list[_np.ndarray]) -> None:
+        with self.lock:
+            for s, a in zip(segs, ids):
+                if s in self.items:
+                    continue
+                self.items[s] = a
+                self.tokens += len(a)
+            while self.tokens > self.budget and self.items:
+                _, old = self.items.popitem(last=False)
+                self.tokens -= len(old)
+
+
+_seg_cache = _SegmentTokenCache(_SEG_BUDGET)
+
+
+def _segmented_encode(tokenizer: Any, text: str, kwargs: dict[str, Any]) -> list[int] | None:
+    """Exact token ids for ``tokenizer(text, **kwargs)`` via cached segments, or
+    None when this prompt/tokenizer is not eligible (caller falls back)."""
+    if len(text) < _SEG_MIN_CHARS or _SEG_SEP not in text:
+        return None
+    if set(kwargs) - {"truncation", "max_length", "add_special_tokens"}:
+        return None
+    state = getattr(tokenizer, "_exp_seg_state", None)
+    if state is None:
+        backend = getattr(tokenizer, "backend_tokenizer", None) or getattr(
+            tokenizer, "_tokenizer", None
+        )
+        ok = backend is not None and hasattr(backend, "encode_batch")
+        if ok:
+            # Eligible only if the separator is one special token and special
+            # tokens add nothing (no BOS/EOS), so concatenation is exact.
+            sep_ids = tokenizer(_SEG_SEP, add_special_tokens=False)["input_ids"]
+            ok = len(sep_ids) == 1 and tokenizer("a", add_special_tokens=True)[
+                "input_ids"
+            ] == tokenizer("a", add_special_tokens=False)["input_ids"]
+        state = backend if ok else False
+        try:
+            tokenizer._exp_seg_state = state
+        except Exception:
+            pass
+        logger.info("segmented prompt tokenization %s", "on" if ok else "not eligible")
+    if state is False:
+        return None
+    parts = text.split(_SEG_SEP)
+    segs = ([parts[0]] if parts[0] else []) + [_SEG_SEP + p for p in parts[1:]]
+    cached = _seg_cache.get_many(segs)
+    missing = [s for s, c in zip(segs, cached) if c is None]
+    if missing:
+        enc = state.encode_batch(missing, add_special_tokens=False)
+        new = [_np.asarray(e.ids, dtype=_np.int32) for e in enc]
+        _seg_cache.put_many(missing, new)
+        fresh = dict(zip(missing, new))
+        cached = [c if c is not None else fresh[s] for s, c in zip(segs, cached)]
+    ids = _np.concatenate(cached).tolist()
+    if kwargs.get("truncation") and kwargs.get("max_length") is not None:
+        ids = ids[: kwargs["max_length"]]
+    return ids
