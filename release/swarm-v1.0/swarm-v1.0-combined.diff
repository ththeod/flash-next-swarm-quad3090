+def test_adaptive_retention_follows_capacity_failures(monkeypatch):
+    """(local 2026-10-22) VLLM_E2_MAMBA_RETAIN_ADAPTIVE_S: the first capacity
+    failure switches checkpoint retention off (once), and it comes back on
+    only after that many seconds without another failure."""
+    monkeypatch.setenv("VLLM_E2_MAMBA_RETAIN_ADAPTIVE_S", "45")
+    if hasattr(envs.__getattr__, "cache_clear"):
