@@ -0,0 +1,34 @@
+# SPDX-License-Identifier: Apache-2.0
+"""W4A8-INT8 Marlin MoE (local 2026-10-23, W45): the compressed-tensors WNA16 MoE method must hand the INT8 global
+activation scales to the kernel's quant config (auto_awq already does); without them the expert outputs were scaled by
+~max(weight scale)/4096 and the model produced noise."""
+from types import SimpleNamespace
+
+import torch
+
+from vllm.model_executor.layers.fused_moe.oracle.int_wna16 import WNA16MoEBackend
+from vllm.model_executor.layers.quantization.compressed_tensors.compressed_tensors_moe.compressed_tensors_moe_wna16 import (  # noqa: E501
+    CompressedTensorsWNA16MoEMethod,
+)
+
+
+def _method():
+    m = object.__new__(CompressedTensorsWNA16MoEMethod)
+    m.wna16_backend = WNA16MoEBackend.MARLIN
+    m.group_size, m.num_bits = 128, 4
+    return m
+
+
+def _layer(**extra):
+    return SimpleNamespace(w13_weight_scale=torch.ones(2, 20, 1280), w2_weight_scale=torch.ones(2, 5, 2560), **extra)
+
+
+def test_int8_global_scales_reach_the_quant_config():
+    g1, g2 = torch.tensor(2.1e-5), torch.tensor(1.7e-5)
+    cfg = _method().get_fused_moe_quant_config(_layer(w13_input_global_scale=g1, w2_input_global_scale=g2))
+    assert cfg.a1_gscale is g1 and cfg.a2_gscale is g2
+
+
+def test_bf16_activations_have_no_global_scales():
+    cfg = _method().get_fused_moe_quant_config(_layer())
+    assert cfg.a1_gscale is None and cfg.a2_gscale is None
