+    k = [make_offload_key(f"d{i}".encode(), 0) for i in range(4)]
+    manager.prepare_store(k[:3], _EMPTY_REQ_CTX)
+    manager.complete_store(k[:2], _EMPTY_REQ_CTX)  # k0, k1 stored; k2 still being written
+    list(manager.take_events())
+    manager.prepare_load([k[1]], _EMPTY_REQ_CTX)    # k1 being read
+
+    assert manager.discard([k[0], k[1], k[2], k[3]], _EMPTY_REQ_CTX) == [k[0]]
+    assert manager.lookup(k[0], _EMPTY_REQ_CTX) is LookupResult.MISS
+    assert manager.lookup(k[1], _EMPTY_REQ_CTX) is LookupResult.HIT
+    [event] = list(manager.take_events())
+    assert event.removed and list(event.keys) == [k[0]]
+
+    # the freed slot is reused without eviction; the busy ones are kept
+    out = manager.prepare_store([k[3]], _EMPTY_REQ_CTX)
+    assert out is not None and out.keys_to_store == [k[3]] and not out.evicted_keys
+    manager.complete_load([k[1]], _EMPTY_REQ_CTX)
+    manager.complete_store([k[2], k[3]], _EMPTY_REQ_CTX)
+    assert manager.discard([k[1]], _EMPTY_REQ_CTX) == [k[1]]
+    # 2 slots free now (k1's and one never used); 3 new keys evict exactly one stored key,
+    # and the evictable count still covers k2 and k3
+    new = [make_offload_key(f"n{i}".encode(), 0) for i in range(3)]
+    out = manager.prepare_store(new, _EMPTY_REQ_CTX)
+    assert out is not None and out.keys_to_store == new and out.evicted_keys == [k[2]]
+    assert manager._num_evictable_cache_chunks == 1
