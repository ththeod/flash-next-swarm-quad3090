+def hc_fused_slot(down: nn.Module) -> int | None:
+    """Slot of a HyperConnection down projection when the fused HC chain is on
+    (it needs the down projection's scratch slot); None keeps the unfused ops."""
+    if not HC_FUSE:
+        return None
+    method = getattr(down, "quant_method", None)
+    return method.slot if isinstance(method, SkinnyLinearMethod) else None
