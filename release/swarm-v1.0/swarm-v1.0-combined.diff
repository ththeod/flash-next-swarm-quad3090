+def test_pp_decode_balance_evens_out_microbatches(monkeypatch):
+    """Decodes alternate between pp_size steps and keep the split admission
+    gave them; VLLM_E2_PP_DECODE_BALANCE caps a step at ceil(decoding /
+    pp_size), so the 6/2 split becomes 4/4 within one cycle."""
+    assert _pp2_decode_split(monkeypatch, "0") == [6, 2] * 4
+    split = _pp2_decode_split(monkeypatch, "1")
+    assert split[0] == 4 and split[2:] == [4] * 6, split
+    assert sum(split[:2]) == 8, split  # nobody is dropped in the switch-over
+
