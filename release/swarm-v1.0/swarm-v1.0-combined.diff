+@pytest.mark.parametrize("nc,accepted,bs", ALIGN_CASES)
+def test_align_boundary_with_v2_precopy_source(nc, accepted, bs):
+    """V2 runner placement: the align pre-copy moves the checkpoint into the block
+    of the scheduled window's last token (seq_len - 1), so a window whose accepted
+    tokens cross a boundary commits its final state into its own source block and
+    its boundary state into the block before. The boundary state must still be
+    folded from the source (start) state, not from the just-stored final state."""
+    inp = _make([T], nb=12)
+    bt = torch.arange(2, 8, dtype=torch.int32, device="cuda").reshape(1, 6)
+    src = bt[0, (nc + T - 1) // bs].reshape(1).contiguous()
+    inp["state_indices"] = src
+    _verify(inp)
+    _, states = _native(inp)
+    ckpt = inp["checkpoint_state"].clone()
+    ctx = _context(inp, ckpt)
+    ctx.commit(
+        torch.tensor([accepted], dtype=torch.int32, device="cuda"),
+        src,
+        inp["query_start_loc"],
+        block_table=bt,
+        num_computed_tokens=torch.tensor([nc], dtype=torch.int32, device="cuda"),
+        mamba_block_size=bs,
+    )
+    next_boundary = (nc // bs + 1) * bs
+    final_blk = int(bt[0, max(nc + accepted - 1, 0) // bs])
+    if nc + accepted >= next_boundary:
+        boundary_blk = int(bt[0, next_boundary // bs - 1])
+        assert torch.equal(ckpt[boundary_blk], states[next_boundary - nc - 1])
+    assert torch.equal(ckpt[final_blk], states[accepted - 1])
+
+
